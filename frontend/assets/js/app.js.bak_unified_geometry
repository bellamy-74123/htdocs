window.getSuppliersList = function() {
    const defaultSuppliers = [
        { id: 1, name: "الشركة الوطنية للتموين الطبي الموحد", contact_person: "أ. خالد النجار", phone: "0501234567", email: "supply@national-med.sa", address: "الرياض - طريق الملك فهد", specialty: "أدوية عامة ومضادات" },
        { id: 2, name: "مؤسسة الأدوية والمستلزمات الطبية الحديثة", contact_person: "د. سامي الحداد", phone: "0559876543", email: "info@modern-pharma.sa", address: "جدة - شارع الأندلس", specialty: "أدوية القلب والسكري" },
        { id: 3, name: "مستودع الأمل الدوائي المركزي", contact_person: "أ. طارق العريقي", phone: "0543210987", email: "sales@alamal-pharma.sa", address: "مكة المكرمة - العزيزية", specialty: "محاليل ومسكنات وفيتامينات" }
    ];
    try {
        const custom = localStorage.getItem('custom_suppliers');
        if (custom) {
            const parsed = JSON.parse(custom);
            if (Array.isArray(parsed) && parsed.length > 0) {
                return [...defaultSuppliers, ...parsed];
            }
        }
    } catch (e) {}
    return defaultSuppliers;
};

window.saveCustomSupplier = function(sup) {
    try {
        const custom = localStorage.getItem('custom_suppliers');
        let list = custom ? JSON.parse(custom) : [];
        const newId = 100 + list.length + 1;
        sup.id = newId;
        list.push(sup);
        localStorage.setItem('custom_suppliers', JSON.stringify(list));
        return sup;
    } catch (e) {
        console.error("Save supplier error:", e);
        return sup;
    }
};


