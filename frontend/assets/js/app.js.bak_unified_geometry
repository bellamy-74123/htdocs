};

window.saveMedicineRequest = function(req) {
    try {
        const list = window.getMedicineRequests();
        const newId = list.length > 0 ? Math.max(...list.map(x => x.id || 0)) + 1 : 1;
        req.id = newId;
        req.created_at = new Date().toISOString().replace('T', ' ').substring(0, 16);
        req.status = "قيد المراجعة";
        list.unshift(req);
        localStorage.setItem('pharmacy_medicine_requests', JSON.stringify(list));
        return req;
    } catch (e) {
        console.error("Error saving medicine request:", e);
        return req;
    }
};

window.updateMedicineRequestStatus = function(id, status, notes = '') {
    try {
        const list = window.getMedicineRequests();
        const item = list.find(x => x.id === id);
        if (item) {
            item.status = status;
            if (notes) item.manager_notes = notes;
            localStorage.setItem('pharmacy_medicine_requests', JSON.stringify(list));
        }
        return item;
    } catch (e) {
        console.error("Error updating request status:", e);
    }
};
