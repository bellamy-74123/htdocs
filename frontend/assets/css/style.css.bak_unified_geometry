/* ==========================================================================
   نظام التناسق اللوني الطبي الهادئ والباستيلي (Soft Pastel Clinical Harmony)
   ألوان فاتحة منخفضة التشبع تجمع بين السماوي الهادئ، النعناعي الفاتح، والرمادي الناعم
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700;800;900&display=swap');

:root {
    /* 60% الخلفيات والمساحات الفاتحة المريحة للعين (Soft Slate & Crisp White) */
    --bg-main: #f8fafc;        /* خلفية رمادية فاتحة جداً وناعمة تمنع إجهاد العين */
    --bg-card: #ffffff;        /* بطاقات بيضاء ناصعة وناعمة */
    --bg-hover: #f1f5f9;       /* لون تفاعل ناعم جداً */
    --bg-glass: rgba(255, 255, 255, 0.95);

    /* 30% الهوية السريرية الفاتحة منخفضة التشبع (Soft Sky & Pastel Mint) */
    --primary: #0284c7;        /* أزرق سماوي سريري متزن */
    --primary-dark: #0369a1;   /* أزرق طبي ناعم */
    --primary-light: #f0f9ff;  /* رذاذ سماوي فائق النعومة والخفة */
    --primary-gradient: linear-gradient(135deg, #38bdf8 0%, #0284c7 100%); /* أزرق سماوي سريري نقي للأزرار */
    
    /* ألوان الأيقونات السريرية بدرجات الأزرق الفاتح الطبي (Hospital Clinical Light Blue) */
    --hospital-blue: #38bdf8;        /* أزرق سماوي فاتح معتمد بالمستشفيات والمراكز الطبية */
    --hospital-blue-dark: #0284c7;   /* أزرق سماوي مركز */
    --hospital-blue-light: #e0f2fe;  /* خلفية ثلجية زرقاء فائقة النعومة */
    --hospital-blue-border: #bae6fd; /* حدود زرقاء فاتحة رقيقة */
    --icon-color: #38bdf8;

    --mint: #34d399;           /* أخضر نعناعي باستيلي فاتح */
    --mint-dark: #10b981;      /* أخضر مهدئ */
    --mint-light: #f0fdf4;     /* خلفية نعناعية فائقة النعومة */
    --mint-gradient: linear-gradient(135deg, #6ee7b7 0%, #5eead4 100%);

    --accent: #334155;         /* سليت رمادي هادئ للترويسات والطباعة */

    /* النصوص والتباين المريح الفاتح (Soft Slate Typography) */
    --text-main: #1e293b;      /* نص أساسي بلون السليت المتزن عالي الوضوح بدون قتامة */
    --text-muted: #64748b;     /* نصوص ثانوية رمادية هادئة */
    --border: #e2e8f0;         /* حدود ناعمة وخفيفة جداً */
    --border-focus: #7dd3fc;   /* إطار تركيز سماوي فاتح */

    /* 10% ألوان الدلالة الوظيفية الباستيلية الفاتحة (Soft Semantic Tones) */
    --success: #10b981;        /* أخضر نعناعي هادئ */
    --success-bg: #f0fdf4;     /* خلفية خضراء باستيلية خفيفة */
    --warning: #f59e0b;        /* عنبري دافئ هادئ */
    --warning-bg: #fffdf0;     /* خلفية عنبرية ناعمة */
    --danger: #f87171;         /* وردي مرجاني فاتح غير فاقع */
    --danger-bg: #fef2f2;      /* خلفية وردية خفيفة جداً */

    /* المؤثرات والظلال الانسيابية الخفيفة */
    --shadow-sm: 0 1px 2px 0 rgba(15, 23, 42, 0.03);
    --shadow: 0 3px 6px -1px rgba(15, 23, 42, 0.04), 0 2px 4px -2px rgba(15, 23, 42, 0.02);
    --shadow-md: 0 8px 12px -3px rgba(15, 23, 42, 0.05), 0 3px 6px -3px rgba(15, 23, 42, 0.02);
    --shadow-lg: 0 16px 20px -4px rgba(15, 23, 42, 0.06), 0 6px 8px -4px rgba(15, 23, 42, 0.03);
    
    --radius-sm: 6px;
    --radius: 10px;
    --radius-lg: 14px;
    --radius-full: 9999px;
    --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

[data-theme="dark"] {
    /* الخلفيات الداكنة باللون الأسود الصافي مع ألوان باستيلية مضيئة بنعومة */
    --bg-main: #000000;        /* خلفية سوداء نقية 100% */
    --bg-card: #0c0c0e;        /* بطاقات سوداء ناعمة */
    --bg-hover: #18181c;       /* لون تفاعل رمادي داكن هادئ */
    --bg-glass: rgba(12, 12, 14, 0.95);

    /* تباين باستيلي ناعم في الوضع الليلي */
    --primary: #7dd3fc;        /* سماوي باستيلي فاتح ومريح في الظلام */
    --primary-dark: #38bdf8;
    --primary-light: rgba(125, 211, 252, 0.1);
    --primary-gradient: linear-gradient(135deg, #7dd3fc 0%, #0284c7 100%);

    --hospital-blue: #7dd3fc;
    --hospital-blue-dark: #38bdf8;
    --hospital-blue-light: rgba(125, 211, 252, 0.12);
    --hospital-blue-border: rgba(125, 211, 252, 0.3);
    --icon-color: #7dd3fc;

    --mint: #6ee7b7;           /* نعناعي باستيلي مضيء بنعومة */
    --mint-dark: #34d399;
    --mint-light: rgba(110, 231, 183, 0.1);
    --mint-gradient: linear-gradient(135deg, #6ee7b7 0%, #5eead4 100%);

    --accent: #bae6fd;

    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --border: #232328;
    --border-focus: #7dd3fc;

    --success: #6ee7b7;
    --success-bg: rgba(110, 231, 183, 0.1);
    --warning: #fcd34d;
    --warning-bg: rgba(252, 211, 77, 0.1);
    --danger: #fca5a5;
    --danger-bg: rgba(252, 165, 165, 0.1);

    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.6);
    --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.7), 0 2px 4px -2px rgba(0, 0, 0, 0.6);
    --shadow-md: 0 10px 15px -3px rgba(0, 0, 0, 0.8), 0 4px 6px -4px rgba(0, 0, 0, 0.6);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.9), 0 8px 10px -6px rgba(0, 0, 0, 0.7);
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Times New Roman', Times, 'Simplified Arabic', serif;
}

button, input, select, textarea, optgroup {
    font-family: 'Times New Roman', Times, 'Simplified Arabic', serif;
}

body {
    font-family: 'Times New Roman', Times, 'Simplified Arabic', serif;
    background-color: var(--bg-main);
    color: var(--text-main);
    line-height: 1.6;
    direction: rtl;
    text-align: right;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
}

/* Navbar */
.navbar {
    background: rgba(255, 255, 255, 0.92);
    border-bottom: 1px solid rgba(226, 232, 240, 0.9);
    padding: 0.55rem 1.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 3px 14px -2px rgba(15, 23, 42, 0.04);
    gap: 0.85rem;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
}

[data-theme="dark"] .navbar {
    background: rgba(12, 12, 14, 0.92) !important;
    border-bottom-color: #27272a !important;
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.7);
}

.logo {
    font-size: 1.15rem;
    font-weight: 900;
    color: var(--primary);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    letter-spacing: -0.01em;
    white-space: nowrap;
    flex-shrink: 0;
}

.nav-links {
    display: flex;
    list-style: none;
    gap: 0.3rem;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin: 0;
    padding: 0;
}

.nav-links li {
    display: inline-flex;
}

.nav-links a {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.84rem;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full);
    transition: var(--transition);
    white-space: nowrap;
}

.nav-links a:hover {
    color: var(--primary);
    background-color: var(--primary-light);
    transform: translateY(-1px);
}

.nav-links a.active {
    color: #ffffff !important;
    background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);
    box-shadow: 0 3px 10px rgba(2, 132, 199, 0.3);
}

.nav-user-section {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    white-space: nowrap;
    flex-shrink: 0;
}

/* Container & Grid */
.container {
    max-width: 1260px;
    margin: 2rem auto;
    padding: 0 1.5rem;
    width: 100%;
    flex: 1;
}

/* Cards */
.card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 1.65rem;
    margin-bottom: 1.65rem;
    box-shadow: 0 4px 18px -2px rgba(15, 23, 42, 0.05);
    transition: var(--transition);
}

.card:hover {
    box-shadow: 0 16px 30px -4px rgba(15, 23, 42, 0.1);
    transform: translateY(-3px);
    border-color: #7dd3fc;
}

[data-theme="dark"] .card:hover {
    border-color: #38bdf8;
}

.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
}

/* Buttons and States */
.btn {
    background-color: var(--primary);
    color: #ffffff;
    border: 1px solid var(--primary);
    padding: 0.55rem 1.3rem;
    border-radius: var(--radius);
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-decoration: none;
    line-height: 1.4;
    box-shadow: var(--shadow-sm);
}

.btn:hover {
    background-color: var(--primary-dark);
    border-color: var(--primary-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(2, 132, 199, 0.35);
}

.btn:active {
    transform: translateY(1px) scale(0.98);
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}

.btn-secondary {
    background-color: var(--bg-card);
    color: var(--text-main);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
}

.btn-secondary:hover {
    background-color: var(--primary-light);
    color: var(--primary);
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(15, 23, 42, 0.08);
}

.btn-danger {
    background-color: var(--danger);
    border-color: var(--danger);
    color: #ffffff;
}

.btn-danger:hover {
    background-color: #ef4444;
    border-color: #ef4444;
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(239, 68, 68, 0.35);
}

.btn-success {
    background-color: var(--success);
    border-color: var(--success);
    color: #ffffff;
}

.btn-success:hover {
    background-color: var(--mint-dark);
    border-color: var(--mint-dark);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(16, 185, 129, 0.35);
}

/* Forms */
.form-group {
    margin-bottom: 1.1rem;
}

.form-group label {
    display: block;
    margin-bottom: 0.35rem;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--text-main);
}

.form-control {
    width: 100%;
    padding: 0.6rem 0.9rem;
    border: 1.5px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--bg-card);
    color: var(--text-main);
    font-size: 0.92rem;
    transition: var(--transition);
}

.form-control:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3.5px rgba(2, 132, 199, 0.18);
}

/* Tables */
table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
}

th, td {
    padding: 0.75rem 1rem;
    text-align: right;
    border-bottom: 1px solid var(--border);
    font-size: 0.95rem;
}

th {
    background-color: var(--primary-light);
    color: var(--primary-dark);
    font-weight: 700;
    font-size: 0.95rem;
}

[data-theme="dark"] th {
    background-color: #1e293b;
    color: #f1f5f9;
    border-bottom: 2px solid #334155;
}

tr:hover {
    background-color: rgba(30, 58, 95, 0.03);
}

[data-theme="dark"] tr:hover {
    background-color: rgba(255, 255, 255, 0.03);
}

/* Badges */
.badge {
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    font-size: 0.82rem;
    font-weight: 700;
    display: inline-block;
    line-height: 1.3;
    transition: var(--transition);
}

.badge-success { 
    background: var(--success-bg); 
    color: var(--success); 
    border: 1px solid rgba(5, 150, 105, 0.2); 
}

.badge-warning { 
    background: var(--warning-bg); 
    color: var(--warning); 
    border: 1px solid rgba(217, 119, 6, 0.2); 
}

.badge-danger { 
    background: var(--danger-bg); 
    color: var(--danger); 
    border: 1px solid rgba(220, 38, 38, 0.2); 
}

.badge-primary { 
    background: var(--primary-light); 
    color: var(--primary-dark); 
    border: 1px solid rgba(2, 132, 199, 0.2); 
}

/* Code tags */
code {
    font-family: monospace;
    background: var(--primary-light);
    color: var(--accent);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.88em;
    border: 1px solid var(--border);
}

[data-theme="dark"] code {
    background: #0f172a;
    color: #38bdf8;
    border-color: #334155;
}

/* Theme Toggle */
.theme-toggle {
    background: transparent;
    border: 1px solid var(--border);
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius);
    cursor: pointer;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-main);
    transition: var(--transition);
}

.theme-toggle:hover {
    background: var(--primary-light);
    color: var(--primary);
    border-color: var(--primary);
}

/* Responsive */
@media (max-width: 1080px) {
    .navbar {
        padding: 0.65rem 1rem;
        gap: 0.5rem;
    }
    .nav-links {
        gap: 0.2rem;
    }
    .nav-links a {
        font-size: 0.82rem;
        padding: 0.25rem 0.45rem;
    }
}

@media (max-width: 820px) {
    .navbar {
        flex-direction: column;
        gap: 0.65rem;
        padding: 0.85rem 1rem;
    }
    .nav-links {
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.35rem;
    }
    .nav-user-section {
        justify-content: center;
        width: 100%;
    }
    .container {
        padding: 0 1rem;
        margin: 1rem auto;
    }
}

/* ==========================================================================
   معايير وثائق الفواتير والإيصالات (خلفية بيضاء نقية ونصوص سوداء دائماً بجميع الأوضاع)
   تطابق 100% بين الوضع المظلم (Dark Mode) والوضع الفاتح لمستندات الفواتير الرسمية
   ========================================================================== */

/* نافذة حوار الفاتورة بالكامل (Modal Dialog) */
#printModal .modal-content,
#viewInvoiceModal .modal-content,
.invoice-modal-dialog,
[data-theme="dark"] #printModal .modal-content,
[data-theme="dark"] #viewInvoiceModal .modal-content,
[data-theme="dark"] .invoice-modal-dialog {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #cbd5e1 !important;
    box-shadow: 0 10px 35px rgba(0, 0, 0, 0.4) !important;
}

#printModal h3,
#viewInvoiceModal h3,
[data-theme="dark"] #printModal h3,
[data-theme="dark"] #viewInvoiceModal h3 {
    color: #0f2942 !important;
}

/* الحاوية وورقة الفاتورة الأساسية */
.invoice-paper,
.thermal-receipt,
.invoice-wrapper,
#printPreviewContainer,
#printPreviewContainer > div,
#invoiceDetailContainer,
#invoiceDetailContainer > div,
#printableArea,
#printableArea > div,
[data-theme="dark"] .invoice-paper,
[data-theme="dark"] .thermal-receipt,
[data-theme="dark"] .invoice-wrapper,
[data-theme="dark"] #printPreviewContainer,
[data-theme="dark"] #printPreviewContainer > div,
[data-theme="dark"] #invoiceDetailContainer,
[data-theme="dark"] #invoiceDetailContainer > div,
[data-theme="dark"] #printableArea,
[data-theme="dark"] #printableArea > div {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border-color: #cbd5e1 !important;
}

/* جميع النصوص والعناوين والفقرات داخل الفاتورة باللون الأسود في الوضعين */
.invoice-paper *,
.thermal-receipt *,
.invoice-wrapper *,
#printPreviewContainer *,
#invoiceDetailContainer *,
#printableArea *,
[data-theme="dark"] .invoice-paper *,
[data-theme="dark"] .thermal-receipt *,
[data-theme="dark"] .invoice-wrapper *,
[data-theme="dark"] #printPreviewContainer *,
[data-theme="dark"] #invoiceDetailContainer *,
[data-theme="dark"] #printableArea * {
    color: #000000 !important;
}

/* استثناء شريط ترويسة الجدول داخل الفاتورة A4 ليبقى كحلياً رسمياً بنص أبيض */
.invoice-paper th,
.invoice-paper th *,
.invoice-wrapper th,
.invoice-wrapper th *,
#printPreviewContainer .invoice-paper th,
#printPreviewContainer .invoice-paper th *,
#invoiceDetailContainer .invoice-paper th,
#invoiceDetailContainer .invoice-paper th *,
#printableArea .invoice-paper th,
#printableArea .invoice-paper th *,
[data-theme="dark"] .invoice-paper th,
[data-theme="dark"] .invoice-paper th *,
[data-theme="dark"] .invoice-wrapper th,
[data-theme="dark"] .invoice-wrapper th *,
[data-theme="dark"] #printPreviewContainer .invoice-paper th,
[data-theme="dark"] #printPreviewContainer .invoice-paper th *,
[data-theme="dark"] #invoiceDetailContainer .invoice-paper th,
[data-theme="dark"] #invoiceDetailContainer .invoice-paper th *,
[data-theme="dark"] #printableArea .invoice-paper th,
[data-theme="dark"] #printableArea .invoice-paper th * {
    background: #0f2942 !important;
    background-color: #0f2942 !important;
    color: #ffffff !important;
    border: 1px solid #0f2942 !important;
}

/* ترويسة جدول الإيصال الحراري */
.thermal-receipt th,
.thermal-receipt th *,
#printPreviewContainer .thermal-receipt th,
#printPreviewContainer .thermal-receipt th *,
#printableArea .thermal-receipt th,
#printableArea .thermal-receipt th *,
[data-theme="dark"] .thermal-receipt th,
[data-theme="dark"] .thermal-receipt th *,
[data-theme="dark"] #printPreviewContainer .thermal-receipt th,
[data-theme="dark"] #printPreviewContainer .thermal-receipt th *,
[data-theme="dark"] #printableArea .thermal-receipt th,
[data-theme="dark"] #printableArea .thermal-receipt th * {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border: none !important;
    border-bottom: 1px solid #000000 !important;
}

/* جداول وخلايا وصفوف الفاتورة */
.invoice-paper table,
.thermal-receipt table,
.invoice-wrapper table,
#printPreviewContainer table,
#invoiceDetailContainer table,
#printableArea table,
[data-theme="dark"] .invoice-paper table,
[data-theme="dark"] .thermal-receipt table,
[data-theme="dark"] .invoice-wrapper table,
[data-theme="dark"] #printPreviewContainer table,
[data-theme="dark"] #invoiceDetailContainer table,
[data-theme="dark"] #printableArea table {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border-collapse: collapse !important;
}

.invoice-paper td,
.invoice-wrapper td,
#printPreviewContainer .invoice-paper td,
#invoiceDetailContainer .invoice-paper td,
#printableArea .invoice-paper td,
[data-theme="dark"] .invoice-paper td,
[data-theme="dark"] .invoice-wrapper td,
[data-theme="dark"] #printPreviewContainer .invoice-paper td,
[data-theme="dark"] #invoiceDetailContainer .invoice-paper td,
[data-theme="dark"] #printableArea .invoice-paper td {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border: 1px solid #cbd5e1 !important;
}

.invoice-paper tr:nth-child(even) td,
.invoice-wrapper tr:nth-child(even) td,
[data-theme="dark"] .invoice-paper tr:nth-child(even) td,
[data-theme="dark"] .invoice-wrapper tr:nth-child(even) td {
    background: #f8fafc !important;
    background-color: #f8fafc !important;
}

.invoice-paper tr:hover,
.invoice-wrapper tr:hover,
#printPreviewContainer tr:hover,
#invoiceDetailContainer tr:hover,
#printableArea tr:hover,
[data-theme="dark"] .invoice-paper tr:hover,
[data-theme="dark"] .invoice-wrapper tr:hover,
[data-theme="dark"] #printPreviewContainer tr:hover,
[data-theme="dark"] #invoiceDetailContainer tr:hover,
[data-theme="dark"] #printableArea tr:hover {
    background: #ffffff !important;
    background-color: #ffffff !important;
}

.thermal-receipt td,
#printPreviewContainer .thermal-receipt td,
#printableArea .thermal-receipt td,
[data-theme="dark"] .thermal-receipt td,
[data-theme="dark"] #printPreviewContainer .thermal-receipt td,
[data-theme="dark"] #printableArea .thermal-receipt td {
    background: #ffffff !important;
    background-color: #ffffff !important;
    color: #000000 !important;
    border: none !important;
    border-bottom: 1px dashed #cccccc !important;
}

/* صندوق بيانات رأس الفاتورة */
.invoice-header-box,
.invoice-paper .invoice-header-box,
.invoice-wrapper .invoice-header-box,
#printPreviewContainer .invoice-header-box,
#invoiceDetailContainer .invoice-header-box,
[data-theme="dark"] .invoice-header-box,
[data-theme="dark"] .invoice-paper .invoice-header-box,
[data-theme="dark"] .invoice-wrapper .invoice-header-box,
[data-theme="dark"] #printPreviewContainer .invoice-header-box,
[data-theme="dark"] #invoiceDetailContainer .invoice-header-box {
    background: #f8fafc !important;
    background-color: #f8fafc !important;
    color: #000000 !important;
    border: 1px solid #e2e8f0 !important;
}

.invoice-header-box *,
[data-theme="dark"] .invoice-header-box * {
    color: #000000 !important;
}

/* ==========================================================================
   إلزام النصوص البيضاء الناصعة في المظهر الأسود (Dark Mode High Legibility)
   ========================================================================== */
[data-theme="dark"] body {
    color: #ffffff !important;
}

[data-theme="dark"] h1,
[data-theme="dark"] h2,
[data-theme="dark"] h3:not(#printModal h3):not(#viewInvoiceModal h3),
[data-theme="dark"] h4,
[data-theme="dark"] h5,
[data-theme="dark"] h6 {
    color: #ffffff !important;
}

[data-theme="dark"] label {
    color: #ffffff !important;
}

[data-theme="dark"] p {
    color: #cbd5e1 !important;
}

[data-theme="dark"] td:not(.invoice-paper td):not(.thermal-receipt td):not(#printPreviewContainer td):not(#invoiceDetailContainer td):not(#printableArea td) {
    color: #ffffff !important;
}

[data-theme="dark"] .summary-box,
[data-theme="dark"] .summary-row,
[data-theme="dark"] .summary-box span:not(#changeDueVal) {
    color: #ffffff !important;
}

[data-theme="dark"] .summary-row.total span {
    color: #38bdf8 !important;
}

[data-theme="dark"] .form-control {
    color: #ffffff !important;
    background-color: #0e0e10 !important;
    border-color: #27272a !important;
}

/* ==========================================================================
   مكونات الواجهة الطبية العصرية ونقاط البيع السريعة (Modern Pharmacy UI Kit)
   ========================================================================== */

/* بطاقات المؤشرات الحيوية السريعة (Modern KPI Cards) */
.kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.15rem;
    margin-bottom: 1.5rem;
}

.kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.4rem;
    box-shadow: var(--shadow);
    transition: var(--transition);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.kpi-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
}

.kpi-card::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 4px;
    height: 100%;
    background: var(--primary);
}

.kpi-card.kpi-primary::before { background: var(--primary); }
.kpi-card.kpi-success::before { background: var(--success); }
.kpi-card.kpi-warning::before { background: var(--warning); }
.kpi-card.kpi-danger::before { background: var(--danger); }

.kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.kpi-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-muted);
}

.kpi-value {
    font-size: 1.85rem;
    font-weight: 900;
    color: var(--text-main);
    line-height: 1.2;
    margin: 0.2rem 0;
}

.kpi-sub {
    font-size: 0.8rem;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 0.35rem;
}

/* شبكة إجراءات الصيدلي السريعة (Quick Action Hub) */
.quick-actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.15rem;
    margin-top: 1.25rem;
}

.action-card-modern {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.4rem;
    text-decoration: none;
    color: var(--text-main);
    box-shadow: var(--shadow);
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
}

.action-card-modern:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--primary);
    background: var(--bg-card);
}

.action-card-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    font-weight: 900;
    margin-bottom: 0.9rem;
}

.icon-blue { background: var(--primary-light); color: var(--primary); }
.icon-green { background: var(--success-bg); color: var(--success); }
.icon-amber { background: var(--warning-bg); color: var(--warning); }
.icon-red { background: var(--danger-bg); color: var(--danger); }

.action-card-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.35rem;
}

.action-card-desc {
    font-size: 0.86rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
}

.action-card-btn {
    align-self: flex-start;
    font-size: 0.84rem;
    font-weight: 800;
    color: var(--primary);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
}

/* شريط الفلاتر الحركية (Pill Filter Bar) */
.pill-filter-bar {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
    margin: 1rem 0;
}

.pill-btn {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.4rem 0.95rem;
    border-radius: var(--radius-full);
    font-size: 0.86rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
}

.pill-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-light);
}

.pill-btn.active {
    background: var(--primary-gradient);
    color: #ffffff !important;
    border-color: var(--primary);
    box-shadow: 0 2px 6px rgba(2, 132, 199, 0.3);
}

/* شريط التنبيهات العاجلة الحي (Urgent Live Ticker) */
.urgent-ticker-banner {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-right: 4px solid var(--warning);
    border-radius: var(--radius);
    padding: 0.85rem 1.25rem;
    margin-bottom: 1.25rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
}

.pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--success);
    display: inline-block;
    box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7);
    animation: pulseAnimation 2s infinite;
}

@keyframes pulseAnimation {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(5, 150, 105, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }
}

/* أزرار الإجراءات السريعة بنقاط البيع (Fast POS Buttons) */
.btn-pos {
    background: var(--primary-gradient);
    color: #ffffff !important;
    border: none;
    font-weight: 800;
    box-shadow: 0 4px 10px rgba(2, 132, 199, 0.3);
    padding: 0.65rem 1.4rem;
}

.btn-pos:hover {
    box-shadow: 0 6px 14px rgba(2, 132, 199, 0.45);
    transform: translateY(-2px);
}

/* ==========================================================================
   مكونات التنبؤ الذكي والتعلم الآلي (AI & Predictive Analytics Components)
   ========================================================================== */
.ai-tab-nav {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    background: var(--bg-hover);
    padding: 0.3rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
}

.ai-tab-btn {
    padding: 0.42rem 0.95rem;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.83rem;
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
}

.ai-tab-btn:hover {
    background: var(--bg-card);
    color: var(--primary);
    border-color: var(--border);
}

.ai-tab-btn.active {
    background: var(--primary-gradient);
    color: #ffffff !important;
    font-weight: 800;
    border-color: transparent;
    box-shadow: 0 3px 10px rgba(2, 132, 199, 0.3);
}

.ai-kpi-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    cursor: pointer;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
}

.ai-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--primary);
}

.ai-kpi-card.active {
    border-color: var(--primary);
    background: var(--primary-light);
}

.forecast-day-pill {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.5rem 0.35rem;
    text-align: center;
    transition: var(--transition);
}

.forecast-day-pill:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
}

/* ==========================================================================
   الأيقونات السريرية باللون الأزرق الفاتح الطبي (Hospital Clinical Light Blue Icons)
   ========================================================================== */
.hospital-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: var(--hospital-blue-light);
    color: var(--hospital-blue-dark);
    border: 1px solid var(--hospital-blue-border);
    flex-shrink: 0;
    transition: var(--transition);
}

[data-theme="dark"] .hospital-icon-badge {
    color: var(--hospital-blue);
}

.hospital-icon-badge:hover {
    transform: scale(1.05);
    border-color: var(--hospital-blue);
}

.hospital-icon, .icon-hospital, .icon-blue {
    color: var(--hospital-blue) !important;
    fill: currentColor;
}

svg.hospital-icon, svg.icon-blue {
    color: var(--hospital-blue);
    stroke: currentColor;
}

.icon-box-sky {
    background: var(--hospital-blue-light);
    color: var(--hospital-blue-dark);
    border: 1px solid var(--hospital-blue-border);
    border-radius: 10px;
    padding: 0.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

[data-theme="dark"] .icon-box-sky {
    color: var(--hospital-blue);
}

/* ==========================================================================
   معايير الطباعة الموحدة لمنع الصفحات الفارغة وإخفاء روابط وامتداد الملفات
   ========================================================================== */

/* ==========================================================================
   نظام الأيقونات السريرية الموحد (Unified Clinical Icon Badge System)
   ========================================================================== */
.hospital-icon-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--hospital-blue-light);
    color: var(--hospital-blue-dark);
    border: 1px solid var(--hospital-blue-border);
    flex-shrink: 0;
    transition: var(--transition);
    vertical-align: middle;
}

.hospital-icon-badge.icon-blue {
    background: var(--hospital-blue-light);
    color: var(--hospital-blue-dark);
    border-color: var(--hospital-blue-border);
}

.hospital-icon-badge.icon-green {
    background: var(--success-bg);
    color: var(--success);
    border-color: rgba(16, 185, 129, 0.25);
}

.hospital-icon-badge.icon-amber {
    background: var(--warning-bg);
    color: var(--warning);
    border-color: rgba(245, 158, 11, 0.25);
}

.hospital-icon-badge.icon-red {
    background: var(--danger-bg);
    color: var(--danger);
    border-color: rgba(248, 113, 113, 0.25);
}

.hospital-icon-badge.icon-slate {
    background: var(--bg-hover);
    color: var(--text-muted);
    border-color: var(--border);
}

[data-theme="dark"] .hospital-icon-badge.icon-blue {
    background: rgba(125, 211, 252, 0.12);
    color: var(--hospital-blue);
    border-color: rgba(125, 211, 252, 0.3);
}

[data-theme="dark"] .hospital-icon-badge.icon-green {
    background: rgba(110, 231, 183, 0.1);
    color: var(--success);
    border-color: rgba(110, 231, 183, 0.25);
}

[data-theme="dark"] .hospital-icon-badge.icon-amber {
    background: rgba(252, 211, 77, 0.1);
    color: var(--warning);
    border-color: rgba(252, 211, 77, 0.25);
}

[data-theme="dark"] .hospital-icon-badge.icon-red {
    background: rgba(252, 165, 165, 0.1);
    color: var(--danger);
    border-color: rgba(252, 165, 165, 0.25);
}

.hospital-icon-badge:hover {
    transform: scale(1.05);
}

/* تنسيق الأيقونات داخل الأزرار والروابط */
.btn svg, .btn-pos svg, .btn-secondary svg, .btn-danger svg {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
    margin-inline-end: 0.35rem;
}

/* ==========================================================================
   مربع حالة الاعتماد الموحد (Unified Approval Status Box)
   ========================================================================== */
.approval-status-card {
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(52, 211, 153, 0.03) 100%), var(--bg-card);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-right: 4.5px solid var(--success);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.4rem;
    margin-top: 1rem;
    box-shadow: 0 4px 14px -2px rgba(16, 185, 129, 0.08);
    transition: var(--transition);
    text-align: right;
}

[data-theme="dark"] .approval-status-card {
    background: linear-gradient(135deg, rgba(110, 231, 183, 0.08) 0%, rgba(12, 12, 14, 0.95) 100%), var(--bg-card);
    border-color: rgba(110, 231, 183, 0.25);
    border-right-color: var(--success);
    box-shadow: 0 4px 16px -2px rgba(0, 0, 0, 0.6);
}

.approval-status-card .status-header {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 0.85rem;
}

.approval-status-card .status-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--text-main);
    line-height: 1.3;
}

.approval-status-card .status-desc {
    font-size: 0.86rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    line-height: 1.5;
}

.approval-status-card .status-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    padding: 0.6rem 0.85rem;
    background: rgba(255, 255, 255, 0.7);
    border-radius: var(--radius);
    border: 1px dashed rgba(16, 185, 129, 0.3);
    margin-bottom: 0.9rem;
    font-size: 0.86rem;
}

[data-theme="dark"] .approval-status-card .status-meta {
    background: rgba(24, 24, 28, 0.6);
    border-color: rgba(110, 231, 183, 0.25);
}

.approval-status-card .status-actions {
    display: flex;
    gap: 0.55rem;
    flex-wrap: wrap;
    align-items: center;
}


/* ==========================================================================
   تنسيق الاسم العلمي والمادة الفعالة الموحد (Unified Generic Name Typography)
   ========================================================================== */
.generic-name, .med-generic, .active-substance {
    font-family: 'Times New Roman', Times, 'Simplified Arabic', serif !important;
    font-size: 0.88rem;
    color: var(--text-muted);
    font-style: italic;
    font-weight: 600;
    letter-spacing: normal;
    display: inline-block;
}

[data-theme="dark"] .generic-name,
[data-theme="dark"] .med-generic,
[data-theme="dark"] .active-substance {
    color: #cbd5e1;
}

/* توحيد أي عناصر code داخل الجداول والبطاقات لتطابق خط الموقع الرئيسي */
td code, th code, .spms-med-order-card code, .chat-layout code {
    font-family: 'Times New Roman', Times, 'Simplified Arabic', serif !important;
    font-size: 0.88rem;
    background: transparent;
    border: none;
    padding: 0;
    color: var(--text-muted);
    font-style: italic;
    font-weight: 600;
}

@media print {
    @page {
        size: auto;
        margin: 5mm 8mm;
    }

    *, *::before, *::after {
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
    }

    html, body {
        background: #ffffff !important;
        color: #000000 !important;
        margin: 0 !important;
        padding: 0 !important;
        height: auto !important;
        min-height: auto !important;
        max-height: none !important;
        overflow: visible !important;
        visibility: visible !important;
    }

    body > *:not(#printableArea) {
        display: none !important;
    }

    #printableArea {
        display: block !important;
        position: static !important;
        width: 100% !important;
        margin: 0 auto !important;
        padding: 0 !important;
        background: #ffffff !important;
        color: #000000 !important;
        page-break-after: avoid !important;
        page-break-inside: avoid !important;
        page-break-before: avoid !important;
    }

    #printableArea * {
        visibility: visible !important;
        color: #000000 !important;
    }

    .modal-overlay, .navbar, .spms-chat-widget, #spmsChatContainer, .no-print {
        display: none !important;
    }
}
