/* ==========================================================================
   Chatbot Floating Widget Styles (Saudi Jeddawi / Urban Pharmacy Theme)
   Full Dark Mode & Light Mode Responsive Integration
   Zero Emojis - Clean Geometric Elements & Clear Text Contrast
   ========================================================================== */

.spms-chat-fab {
    position: fixed;
    bottom: 24px;
    left: 24px;
    z-index: 9999;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--primary-gradient, linear-gradient(135deg, #38bdf8 0%, #6ee7b7 100%));
    color: #ffffff;
    box-shadow: 0 6px 18px rgba(56, 189, 248, 0.3);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    outline: none;
}

.spms-chat-fab:hover {
    transform: scale(1.06);
    box-shadow: 0 8px 22px rgba(110, 231, 183, 0.45);
}

.spms-chat-fab svg {
    width: 28px;
    height: 28px;
    fill: currentColor;
}

.spms-chat-modal {
    position: fixed;
    bottom: 94px;
    left: 24px;
    width: 390px;
    height: 550px;
    max-width: calc(100vw - 48px);
    max-height: calc(100vh - 120px);
    background: var(--bg-card);
    border: 1.5px solid var(--border);
    border-radius: 16px;
    box-shadow: var(--shadow-lg, 0 16px 40px rgba(0, 0, 0, 0.3));
    z-index: 9999;
    display: none;
    flex-direction: column;
    overflow: hidden;
    animation: chatPopupIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
}

@keyframes chatPopupIn {
    from {
        opacity: 0;
        transform: translateY(16px) scale(0.96);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

.spms-chat-modal-header {
    background: var(--primary-gradient, linear-gradient(135deg, #0ea5e9 0%, #10b981 100%));
    color: #ffffff;
    padding: 14px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.spms-chat-modal-header h4 {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 800;
    color: #ffffff;
}

.spms-chat-modal-header p {
    margin: 2px 0 0 0;
    font-size: 0.75rem;
    color: #ecfdf5;
    opacity: 0.95;
}

.spms-chat-close-btn {
    background: transparent;
    border: none;
    color: #ffffff;
    cursor: pointer;
    font-size: 1.3rem;
    line-height: 1;
    padding: 4px;
    opacity: 0.85;
    transition: opacity 0.2s;
}

.spms-chat-close-btn:hover {
    opacity: 1;
}

.spms-chat-body {
    flex: 1;
    padding: 14px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--bg-main);
}

.spms-widget-msg {
    display: flex;
    max-width: 90%;
    font-size: 0.88rem;
    line-height: 1.6;
}

.spms-widget-msg.user {
    align-self: flex-start;
}

.spms-widget-msg.user .spms-widget-bubble {
    background: var(--primary-gradient, linear-gradient(135deg, #0ea5e9 0%, #10b981 100%));
    color: #ffffff !important;
    border-radius: 12px 12px 2px 12px;
    padding: 9px 13px;
    box-shadow: 0 2px 6px rgba(14, 165, 233, 0.25);
}

.spms-widget-msg.bot {
    align-self: flex-end;
}

.spms-widget-msg.bot .spms-widget-bubble {
    background: var(--bg-card);
    color: var(--text-main) !important;
    border: 1px solid var(--border);
    border-radius: 12px 12px 12px 2px;
    padding: 11px 14px;
    box-shadow: var(--shadow);
}

.spms-widget-msg.bot .spms-widget-bubble strong,
.spms-widget-msg.bot .spms-widget-bubble span,
.spms-widget-msg.bot .spms-widget-bubble p {
    color: var(--text-main);
}

.spms-widget-footer {
    padding: 10px 14px;
    background: var(--bg-card);
    border-top: 1px solid var(--border);
    display: flex;
    gap: 8px;
}

.spms-widget-footer input {
    flex: 1;
    border: 1.5px solid var(--border);
    border-radius: 8px;
    padding: 8px 12px;
    font-family: inherit;
    font-size: 0.88rem;
    background: var(--bg-main);
    color: var(--text-main);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

.spms-widget-footer input::placeholder {
    color: var(--text-muted);
    opacity: 0.85;
}

.spms-widget-footer input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 2px rgba(14, 165, 233, 0.2);
}

.spms-widget-footer button {
    background: var(--primary-gradient, linear-gradient(135deg, #0ea5e9 0%, #10b981 100%));
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 800;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
}

.spms-widget-footer button:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(16, 185, 129, 0.35);
}
