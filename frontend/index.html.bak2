<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نظام إدارة الصيدلية | البوابة الرئيسية</title>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="assets/css/style.css">
    <link rel="stylesheet" href="assets/css/chatbot-widget.css">
</head>
<body>
    <nav class="navbar"></nav>

    <div class="container">
        <!-- Live Operational Header -->
        <div class="card" style="padding: 1.5rem; background: var(--bg-card); border-right: 4px solid var(--primary); margin-bottom: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                <div>
                    <h1 style="font-size: 1.4rem; font-weight: 900; color: var(--text-main); margin: 0;">نظام إدارة الصيدلية والمخزون الطبي</h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.25rem;">منظومة سريرية لصرف الأدوية، تتبع الصلاحيات FEFO، والتنبؤ التكيفي بالطلب.</p>
                </div>
                <div style="display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center;">
                    <a href="pages/order_create.html" class="btn btn-pos" style="font-size: 0.88rem; padding: 0.5rem 1.25rem; border-radius: var(--radius-full);">
                        + صرف فاتورة (POS)
                    </a>
                    <a href="pages/inventory.html" class="btn btn-secondary" style="font-size: 0.86rem; padding: 0.5rem 1.1rem; border-radius: var(--radius-full);">
                        المخزون
                    </a>
                    <a href="pages/medicines.html" class="btn btn-secondary" style="font-size: 0.86rem; padding: 0.5rem 1.1rem; border-radius: var(--radius-full);">
                        دليل الأدوية
                    </a>
                    <a href="pages/chat.html" class="btn btn-secondary" style="font-size: 0.86rem; padding: 0.5rem 1.1rem; border-radius: var(--radius-full);">
                        المساعد الدوائي
                    </a>
                </div>
            </div>
        </div>

        <!-- Live KPI Metrics Grid -->
        <div class="kpi-grid">
            <div class="kpi-card kpi-primary">
                <div class="kpi-title">إجمالي الأصناف المسجلة</div>
                <div class="kpi-value" id="kpiTotalMeds">121 صنف</div>
                <div class="kpi-sub" style="color: var(--primary);">مزامنة فورية للأرصدة</div>
            </div>

            <div class="kpi-card kpi-success">
                <div class="kpi-title">فواتير الصرف والمبيعات</div>
                <div class="kpi-value" id="kpiTotalOrders">3 فواتير</div>
                <div class="kpi-sub" style="color: var(--text-muted);">المبيعات: <strong id="kpiTotalSales" style="color: var(--text-main);">1,460 ريال</strong></div>
            </div>

            <div class="kpi-card kpi-danger">
                <div class="kpi-title">أصناف تحت حد الطلب (حرج)</div>
                <div class="kpi-value" id="kpiCriticalMeds" style="color: var(--danger);">3 أصناف</div>
                <div class="kpi-sub" style="color: var(--danger);">تستوجب أمر شراء عاجل</div>
            </div>

            <div class="kpi-card kpi-warning">
                <div class="kpi-title">دقة التنبؤ بنفاد الأدوية</div>
                <div class="kpi-value" style="color: var(--warning);">94.2%</div>
                <div class="kpi-sub" style="color: var(--text-muted);">تحديد كميات التوريد المثالية</div>
            </div>
        </div>

        <!-- Urgent Stock Notice Strip -->
        <div class="urgent-ticker-banner">
            <div style="display: flex; align-items: center; gap: 0.6rem;">
                <span class="badge badge-danger" style="font-size: 0.78rem;">تنبيه مخزون</span>
                <span style="font-size: 0.86rem; font-weight: 700; color: var(--text-main);">
                    يوجد 3 أصناف اقتربت من النفاد وتحتاج إعادة طلب (أوجمنتين 1 جم، فولتارين 50 مجم، تاڤانيك 500 مجم).
                </span>
            </div>
            <a href="pages/predictions.html" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.25rem 0.75rem; border-radius: var(--radius-full);">توصيات الشراء</a>
        </div>

        <!-- Clean Services Hub Grid -->
        <div style="margin-top: 1.25rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
                <h2 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0;">الخدمات والعمليات الأساسية</h2>
            </div>

            <div class="quick-actions-grid">
                <a href="pages/order_create.html" class="action-card-modern" style="border-right: 3px solid var(--primary);">
                    <div>
                        <div class="action-card-title">نقطة البيع وصرف الفواتير (POS)</div>
                        <div class="action-card-desc">إصدار فواتير الصرف النقدي والتأمين وأقسام المستشفى مع طباعة حرارية فورية و A4.</div>
                    </div>
                    <div class="action-card-btn">فتح شاشة الصرف &larr;</div>
                </a>

                <a href="pages/medicines.html" class="action-card-modern" style="border-right: 3px solid var(--success);">
                    <div>
                        <div class="action-card-title">دليل الأدوية والمخزون الحي</div>
                        <div class="action-card-desc">استعراض الأدوية، تصفية المجموعات العلاجية، وتحديث الأرصدة والأسعار لحظياً.</div>
                    </div>
                    <div class="action-card-btn">استعراض الأدوية &larr;</div>
                </a>

                <a href="pages/predictions.html" class="action-card-modern" style="border-right: 3px solid var(--warning);">
                    <div>
                        <div class="action-card-title">التنبؤ الذكي بالاستهلاك والتوريد</div>
                        <div class="action-card-desc">توقع استهلاك الأدوية للأيام القادمة واقتراح كميات الشراء المناسبة لتفادي النقص.</div>
                    </div>
                    <div class="action-card-btn">لوحة التنبؤ &larr;</div>
                </a>

                <a href="pages/orders.html" class="action-card-modern" style="border-right: 3px solid var(--accent);">
                    <div>
                        <div class="action-card-title">سجل الفواتير والمبيعات</div>
                        <div class="action-card-desc">أرشيف شامل لكافة عمليات الصرف السابقة مع إمكانية البحث والطباعة وإعادة المعاينة.</div>
                    </div>
                    <div class="action-card-btn">أرشيف الفواتير &larr;</div>
                </a>

                <a href="pages/chat.html" class="action-card-modern" style="border-right: 3px solid var(--mint);">
                    <div>
                        <div class="action-card-title">المساعد الصيدلاني الذكي</div>
                        <div class="action-card-desc">استشارات فورية عن البدائل المتكافئة، مقارنة الأسعار، وفحص تداخلات وتواريخ الصلاحية.</div>
                    </div>
                    <div class="action-card-btn" style="color: var(--mint-dark);">محادثة المساعد &larr;</div>
                </a>

                <a href="pages/dashboard.html" class="action-card-modern" style="border-right: 3px solid var(--danger);">
                    <div>
                        <div class="action-card-title">لوحة المؤشرات والرقابة</div>
                        <div class="action-card-desc">متابعة تواريخ انتهاء الصلاحية FEFO، رصد شذوذ الصرف، وتقارير الجرد الدوري.</div>
                    </div>
                    <div class="action-card-btn" style="color: var(--danger);">عرض المؤشرات &larr;</div>
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="assets/js/supabase-client.js"></script>
    <script src="assets/js/api.js"></script>
    <script src="assets/js/app.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            // تحميل أحدث إحصائيات المخزون والمبيعات
            try {
                const medsRes = await APIClient.request('medicines.php');
                if (medsRes.success && medsRes.data) {
                    const meds = medsRes.data;
                    document.getElementById('kpiTotalMeds').textContent = `${meds.length} صنف`;
                    const crit = meds.filter(m => (m.stock_quantity || 0) <= 20);
                    document.getElementById('kpiCriticalMeds').textContent = `${crit.length} أصناف`;
                }

                const ordersRes = await APIClient.request('orders.php');
                if (ordersRes.success && ordersRes.data) {
                    const orders = ordersRes.data;
                    document.getElementById('kpiTotalOrders').textContent = `${orders.length} فواتير`;
                    const totalSum = orders.reduce((sum, o) => sum + parseFloat(o.total_amount || 0), 0);
                    document.getElementById('kpiTotalSales').textContent = `${totalSum.toFixed(2)} ريال`;
                }
            } catch (e) {}
        });
    </script>
</body>
</html>
