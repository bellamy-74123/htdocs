                            </span>
                            <span style="font-size: 0.8rem; color: var(--primary); font-weight: 800; background: var(--bg-card); padding: 2px 10px; border-radius: 9999px; border: 1px solid var(--border);">
                                مصححة وفق التقلبات الدورية
                            </span>
                        </div>
                        <div id="forecast7DaysGrid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(95px, 1fr)); gap: 0.65rem; text-align: center;">
                            <!-- Dynamically loaded 7 days -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- TAB 2: FEFO BATCHES -->
            <div id="tab-fefo" class="tab-content" style="display: none; margin-top: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
                    <div>
