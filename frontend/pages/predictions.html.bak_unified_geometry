                    </table>
                </div>
            </div>

            <!-- TAB 3: APRIORI RECOMMENDATIONS -->
            <div id="tab-apriori" class="tab-content" style="display: none; margin-top: 1.5rem;">
                <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem;">
                    <div>
                        <h3 style="font-size: 1.22rem; font-weight: 900; margin: 0; color: var(--text-main);">توصيات الأدوية المكملة والبدائل العلاجية (Apriori Market Basket)</h3>
                        <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.2rem;">قواعد ترافق سريري مستنتجة من فواتير المرضى لاقتراح المكملات الوقائية والبدائل المناسبة.</p>
                    </div>
                    <div>
