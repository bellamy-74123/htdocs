    <!-- منطقة مخصصة للطباعة المستقلة -->
    <div id="printableArea" style="display: none;"></div>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="../assets/js/supabase-client.js"></script>
    <script src="../assets/js/api.js"></script>
    <script src="../assets/js/app.js"></script>
    <script>
        let currentCart = [];
        let availableMeds = [];
        let lastSavedInvoice = null;
        try {
            const cached = sessionStorage.getItem('spms_last_invoice');
            if (cached) lastSavedInvoice = JSON.parse(cached);
        } catch(e) {}

        async function initPOS() {
            enforceRoleRestrictions();
            generateInvoiceNumber();
            await loadMedicinesData();

            const urlParams = new URLSearchParams(window.location.search);
            const medIdParam = urlParams.get('med_id');
            const medNameParam = urlParams.get('med_name') || urlParams.get('med');
            const autoAdd = urlParams.get('auto_add');

            let targetMed = null;
            if (medIdParam) {
                targetMed = availableMeds.find(m => m.id === parseInt(medIdParam));
            } else if (medNameParam) {
                targetMed = availableMeds.find(m => m.name.toLowerCase().includes(medNameParam.toLowerCase()));
            }

            if (targetMed && document.getElementById('medSelect')) {
                document.getElementById('medSelect').value = targetMed.id;
                updateMedSelectionInfo();
                if (autoAdd === '1' || autoAdd === 'true') {
                    addItemToInvoice();
                    if (typeof showNotification === 'function') {
                        showNotification(`تمت إضافة صنف «${targetMed.name}» إلى الفاتورة مباشرة من المساعد الذكي.`, 'success');
                    }
                }
            }
        }

        function generateInvoiceNumber() {
            const now = new Date();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const hh = String(now.getHours()).padStart(2, '0');
            const min = String(now.getMinutes()).padStart(2, '0');
            const ss = String(now.getSeconds()).padStart(2, '0');
            const num = `INV-${yyyy}${mm}${dd}-${hh}${min}${ss}`;
            document.getElementById('invNumber').value = num;
            return num;
        }

        function handleInvoiceTypeChange() {
            const type = document.getElementById('invType').value;
            const custLabel = document.getElementById('customerLabel');
            const custInput = document.getElementById('customerName');
            const supSelect = document.getElementById('supplierSelect');

            if (type === 'routine_restock') {
                custLabel.textContent = 'الشركة الموردة المعتمدة (من دليل الموردين)';
                custInput.style.display = 'none';
                supSelect.style.display = 'block';
                populateSuppliersSelect();
            } else if (type === 'department_dispense') {
                custLabel.textContent = 'القسم الطبي المستلم';
                supSelect.style.display = 'none';
                custInput.style.display = 'block';
                custInput.placeholder = 'مثال: قسم العناية المركزة، العمليات...';
                if (!custInput.value || custInput.value.includes('عميل') || custInput.value.includes('شركة')) {
                    custInput.value = 'قسم الطوارئ والعناية المركزة';
                }
            } else {
                // patient_sale
                custLabel.textContent = 'اسم المريض / العميل';
                supSelect.style.display = 'none';
                custInput.style.display = 'block';
                custInput.placeholder = 'اسم المريض أو عميل نقدي...';
                if (!custInput.value || custInput.value.includes('قسم') || custInput.value.includes('شركة')) {
                    custInput.value = 'عميل نقدي';
                }
            }
        }

        function populateSuppliersSelect() {
            const select = document.getElementById('supplierSelect');
            if (!select) return;
            const list = window.getSuppliersList ? window.getSuppliersList() : [];
            select.innerHTML = list.map(s => `
                <option value="${s.name}">${s.name} — [${s.specialty || s.address || 'مورد معتمد'}]</option>
            `).join('');
        }

        async function loadMedicinesData() {
            try {
                const res = await APIClient.request('medicines.php');
                if (res && res.success && Array.isArray(res.data) && res.data.length > 0) {
                    availableMeds = res.data;
                } else if (typeof getPersistentMedicines === 'function') {
                    availableMeds = getPersistentMedicines();
                } else if (typeof DEMO_MEDICINES !== 'undefined' && Array.isArray(DEMO_MEDICINES)) {
                    availableMeds = DEMO_MEDICINES;
                }
            } catch (e) {
                if (typeof getPersistentMedicines === 'function') {
                    availableMeds = getPersistentMedicines();
                } else if (typeof DEMO_MEDICINES !== 'undefined' && Array.isArray(DEMO_MEDICINES)) {
                    availableMeds = DEMO_MEDICINES;
                }
            }

            const sel = document.getElementById('medSelect');
            if (sel) {
                if (availableMeds && availableMeds.length > 0) {
                    sel.innerHTML = availableMeds.map(m => `
                        <option value="${m.id}">${m.name} — (${parseFloat(m.price || 0).toFixed(2)} ريال) - رصيد: ${m.stock_quantity}</option>
                    `).join('');
                    updateMedSelectionInfo();
                } else {
                    sel.innerHTML = '<option value="">لا توجد أدوية مسجلة</option>';
                }
            }
        }

        function updateMedSelectionInfo() {
            const medId = parseInt(document.getElementById('medSelect').value);
            const med = availableMeds.find(m => m.id === medId);
            if (!med) return;

            document.getElementById('infoPrice').textContent = parseFloat(med.price).toFixed(2);
            document.getElementById('infoStock').textContent = med.stock_quantity;
            document.getElementById('infoGeneric').textContent = med.generic_name || '-';

            const qtyInput = document.getElementById('itemQty');
            const invType = document.getElementById('invType').value;
            const role = AppAuth.getNormalizedRole() || 'staff';
            if (role === 'staff' && invType === 'routine_restock') {
                showNotification('عذراً، إصدار فواتير التوريد للموردين صلاحية حصرية لمدير الصيدلية فقط.', 'danger');
                return;
            }
            if (invType !== 'routine_restock') {
                qtyInput.max = med.stock_quantity;
            } else {
                qtyInput.removeAttribute('max');
            }
        }

        function addItemToInvoice() {
            const medId = parseInt(document.getElementById('medSelect').value);
            const qty = parseInt(document.getElementById('itemQty').value) || 1;
            const med = availableMeds.find(m => m.id === medId);
            if (!med) return;

            const invType = document.getElementById('invType').value;
            if (invType !== 'routine_restock' && qty > med.stock_quantity) {
                alert(`الكمية المطلوبة (${qty}) تتجاوز الرصيد المتاح حالياً (${med.stock_quantity} علبة).`);
                return;
            }

            const existingIndex = currentCart.findIndex(item => item.medicine_id === medId);
            if (existingIndex > -1) {
                const newTotalQty = currentCart[existingIndex].quantity + qty;
                if (invType !== 'routine_restock' && newTotalQty > med.stock_quantity) {
                    alert(`إجمالي الكمية في السلة (${newTotalQty}) يتجاوز الرصيد المتاح.`);
                    return;
                }
                currentCart[existingIndex].quantity = newTotalQty;
                currentCart[existingIndex].total_price = currentCart[existingIndex].quantity * currentCart[existingIndex].unit_price;
            } else {
                currentCart.push({
                    medicine_id: med.id,
                    name: med.name,
                    generic_name: med.generic_name,
                    category: med.category,
                    unit_price: parseFloat(med.price),
                    quantity: qty,
                    total_price: parseFloat(med.price) * qty
                });
            }

            renderCartTable();
            recalculateTotals();
            document.getElementById('itemQty').value = 1;
        }

        function modifyItemQty(index, delta) {
            if (!currentCart[index]) return;
            const newQty = currentCart[index].quantity + delta;
            const med = availableMeds.find(m => m.id === currentCart[index].medicine_id);
            const invType = document.getElementById('invType').value;

            if (newQty <= 0) {
                removeItemFromCart(index);
                return;
            }

            if (invType !== 'routine_restock' && med && newQty > med.stock_quantity) {
                alert(`الرصيد المتاح لهذا الصنف هو ${med.stock_quantity} علبة فقط.`);
                return;
            }

            currentCart[index].quantity = newQty;
            currentCart[index].total_price = newQty * currentCart[index].unit_price;
            renderCartTable();
            recalculateTotals();
        }

        function removeItemFromCart(index) {
            currentCart.splice(index, 1);
            renderCartTable();
            recalculateTotals();
        }

        function renderCartTable() {
            const tbody = document.getElementById('cartTableBody');
            const badge = document.getElementById('itemsCountBadge');
            badge.textContent = `${currentCart.length} أصناف`;

            if (currentCart.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">لم تتم إضافة أصناف بعد. اختر صنفاً واضغط "إضافة".</td></tr>`;
                return;
            }

            tbody.innerHTML = currentCart.map((item, idx) => `
                <tr class="item-row">
                    <td>${idx + 1}</td>
                    <td>
                        <strong>${item.name}</strong>
                        <div class="generic-name" style="font-family: 'Times New Roman', Times, 'Simplified Arabic', serif; font-size: 0.82rem; color: var(--text-muted); font-style: italic;">${item.generic_name || ''}</div>
                    </td>
                    <td>${item.unit_price.toFixed(2)}</td>
                    <td>
                        <div style="display: flex; align-items: center; gap: 0.4rem;">
                            <button type="button" class="qty-btn" onclick="modifyItemQty(${idx}, -1)">-</button>
                            <span style="font-weight: 700; min-width: 24px; text-align: center;">${item.quantity}</span>
                            <button type="button" class="qty-btn" onclick="modifyItemQty(${idx}, 1)">+</button>
                        </div>
                    </td>
                    <td style="font-weight: 700; color: var(--primary);">${item.total_price.toFixed(2)}</td>
                    <td>
                        <button type="button" onclick="removeItemFromCart(${idx})" class="btn btn-secondary" style="padding: 0.2rem 0.5rem; font-size: 0.75rem; color: var(--danger); border-color: rgba(239,68,68,0.3);">حذف</button>
                    </td>
                </tr>
            `).join('');
        }

        function recalculateTotals() {
            let subtotal = 0;
            currentCart.forEach(item => {
                subtotal += item.total_price;
            });

            const discount = parseFloat(document.getElementById('discountInput').value) || 0;
            const taxRate = parseFloat(document.getElementById('taxRateSelect').value) || 0;

            const taxableBase = Math.max(0, subtotal - discount);
            const taxAmount = (taxableBase * (taxRate / 100));
            const grandTotal = taxableBase + taxAmount;

            document.getElementById('subtotalVal').textContent = subtotal.toFixed(2);
            document.getElementById('taxVal').textContent = taxAmount.toFixed(2);
            document.getElementById('grandTotalVal').textContent = grandTotal.toFixed(2);

            calculateChange();
        }

        function calculateChange() {
            const grandTotal = parseFloat(document.getElementById('grandTotalVal').textContent) || 0;
            const cashPaid = parseFloat(document.getElementById('cashPaidInput').value) || 0;
            const changeDue = Math.max(0, cashPaid - grandTotal);
            document.getElementById('changeDueVal').textContent = changeDue.toFixed(2);
        }


