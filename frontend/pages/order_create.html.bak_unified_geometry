                preview.innerHTML = `
                    <div class="invoice-paper invoice-wrapper" style="background: #ffffff !important; color: #000000 !important; padding: 25px; border: 1px solid #cbd5e1; border-radius: 4px; font-family: 'Times New Roman', serif;">
                        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0f2942; padding-bottom: 12px; margin-bottom: 15px; background: #ffffff;">
                            <div>
                                <h2 style="font-size: 18px; margin: 0; color: #0f2942; font-weight: bold;">صيدلية المستشفى المركزي</h2>
                                <div style="font-size: 13px; color: #334155;">إدارة الخدمات الصيدلانية والإمداد الدوائي</div>
                                <div style="font-size: 12px; color: #475569;">الرقم الضريبي الموحد: 300982341100003</div>
                            </div>
                            <div style="text-align: left;">
                                <div style="font-size: 16px; font-weight: bold; color: #0f2942;">فاتورة صرف دوائي / مبيعات</div>
                                <div style="font-size: 13px; color: #000;">رقم الفاتورة: <strong>${invNum}</strong></div>
                                <div style="font-size: 12px; color: #334155;">التاريخ: ${now}</div>
                            </div>
                        </div>

                        <div class="invoice-header-box" style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: #f8fafc !important; color: #000000 !important; padding: 10px 15px; border-radius: 4px; margin-bottom: 15px; font-size: 13px; border: 1px solid #e2e8f0;">
                            <div><strong>نوع العملية:</strong> ${invType}</div>
                            <div><strong>المستلم / العميل:</strong> ${custName}</div>
                            <div><strong>طريقة السداد:</strong> ${payMethod}</div>
                            <div><strong>الصيدلي المسؤول:</strong> ${cashierName}</div>
                        </div>

                        ${notes ? `
                        <div class="invoice-header-box" style="background: #f8fafc !important; color: #000000 !important; padding: 8px 12px; border-radius: 4px; margin-bottom: 15px; font-size: 12.5px; border: 1px solid #e2e8f0;">
                            <strong>توجيهات الاستخدام وجرعة الدواء:</strong> ${notes}
                        </div>` : ''}

                        <table style="width: 100%; border-collapse: collapse; margin-bottom: 15px; font-size: 12.5px; background: #ffffff !important;">
                            <thead>
                                <tr style="background: #0f2942 !important; color: #ffffff !important;">
                                    <th style="border: 1px solid #0f2942; padding: 6px; text-align: right; color: #ffffff !important; background: #0f2942 !important;">#</th>
                                    <th style="border: 1px solid #0f2942; padding: 6px; text-align: right; color: #ffffff !important; background: #0f2942 !important;">اسم الصنف الدوائي</th>
                                    <th style="border: 1px solid #0f2942; padding: 6px; text-align: right; color: #ffffff !important; background: #0f2942 !important;">الاسم العلمي</th>
                                    <th style="border: 1px solid #0f2942; padding: 6px; text-align: center; color: #ffffff !important; background: #0f2942 !important;">سعر الوحدة</th>
                                    <th style="border: 1px solid #0f2942; padding: 6px; text-align: center; color: #ffffff !important; background: #0f2942 !important;">الكمية</th>
                                    <th style="border: 1px solid #0f2942; padding: 6px; text-align: left; color: #ffffff !important; background: #0f2942 !important;">الإجمالي (ريال)</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${itemsToRender.map((item, idx) => `
                                    <tr style="border-bottom: 1px solid #e2e8f0; background: ${idx % 2 === 0 ? '#ffffff' : '#f8fafc'} !important; color: #000000 !important;">
                                        <td style="border: 1px solid #cbd5e1; padding: 6px; color: #000000 !important;">${idx + 1}</td>
                                        <td style="border: 1px solid #cbd5e1; padding: 6px; font-weight: bold; color: #000000 !important;">${item.name || `دواء #${item.medicine_id}`}</td>
                                        <td style="border: 1px solid #cbd5e1; padding: 6px; color: #334155 !important;">${item.generic_name || '-'}</td>
                                        <td style="border: 1px solid #cbd5e1; padding: 6px; text-align: center; color: #000000 !important;">${(parseFloat(item.unit_price) || 0).toFixed(2)}</td>
                                        <td style="border: 1px solid #cbd5e1; padding: 6px; text-align: center; font-weight: bold; color: #000000 !important;">${item.quantity}</td>
                                        <td style="border: 1px solid #cbd5e1; padding: 6px; text-align: left; font-weight: bold; color: #000000 !important;">${(parseFloat(item.total_price) || (parseFloat(item.unit_price) * item.quantity)).toFixed(2)}</td>
                                    </tr>
                                `).join('')}
                            </tbody>
                        </table>

                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 10px; background: #ffffff;">
                            <div style="font-size: 11px; color: #475569; max-width: 50%;">
                                * الأدوية المباعة لا ترد ولا تستبدل بعد خروجها من الصيدلية حفاظاً على شروط التخزين الدوائي.<br>
                                * هذه الفاتورة معتمدة إلكترونياً وصادرة عبر نظام الصيدلية الموحد.
                            </div>
                            <div style="width: 250px; font-size: 13px; line-height: 1.6; color: #000000;">
                                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 3px 0;"><span>المجموع الفرعي:</span><span>${subtotal.toFixed(2)} ريال</span></div>
                                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 3px 0;"><span>قيمة الخصم:</span><span>${discount.toFixed(2)} ريال</span></div>
                                <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 3px 0;"><span>ضريبة القيمة المضافة:</span><span>${tax.toFixed(2)} ريال</span></div>
                                <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 14px; color: #0f2942; padding-top: 5px;"><span>الإجمالي النهائي:</span><span>${grandTotal.toFixed(2)} ريال</span></div>
                            </div>
                        </div>

                        <div style="display: flex; justify-content: space-between; margin-top: 30px; padding-top: 15px; border-top: 1px solid #e2e8f0; font-size: 12px; color: #000000;">
                            <div>توقيع المستلم: ___________________</div>
                            <div>ختم الصيدلية / الاعتماد: ___________________</div>
                        </div>
                    </div>
                `;
            }

            modal.style.display = 'flex';
        }

        function closePrintModal() {
            document.getElementById('printModal').style.display = 'none';
        }

        function executeBrowserPrint() {
            let printArea = document.getElementById('printableArea');
            if (!printArea) {
                printArea = document.createElement('div');
                printArea.id = 'printableArea';
                document.body.appendChild(printArea);
            }
            const previewContent = document.getElementById('printPreviewContainer').innerHTML;
            printArea.innerHTML = previewContent;
            printArea.style.display = 'block';

            window.print();

            setTimeout(() => {
                printArea.style.display = 'none';
                printArea.innerHTML = '';
            }, 1000);
        }
    

        function enforceRoleRestrictions() {
            const role = AppAuth.getNormalizedRole() || 'staff';
            const invTypeSelect = document.getElementById('invType');

            if (role !== 'supervisor' && invTypeSelect) {
                // Pharmacist (cashier) has NO restock or supplier invoice permissions
                const restockOpt = invTypeSelect.querySelector('option[value="routine_restock"]');
                if (restockOpt) restockOpt.remove();
                if (invTypeSelect.value === 'routine_restock') {
                    invTypeSelect.value = 'patient_sale';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', async () => {
            await initPOS();
        });
    </script>
</body>
</html>
