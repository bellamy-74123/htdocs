                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.82rem; font-weight: 700;">نوع العملية / الفاتورة</label>
                            <select id="invType" class="form-control" onchange="handleInvoiceTypeChange()">
