<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>نقاط البيع والفواتير | الصيدلية الذكية SP</title>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="../assets/css/style.css?v=4.0">
    <link rel="stylesheet" href="../assets/css/chatbot-widget.css?v=4.0">
    <style>
        .pos-grid {
            display: grid;
            grid-template-columns: 1.15fr 0.85fr;
            gap: 1.25rem;
            align-items: start;
        }
        @media (max-width: 900px) {
            .pos-grid {
                grid-template-columns: 1fr;
            }
        }
        .item-row {
            transition: background 0.15s ease;
        }
        .item-row:hover {
            background-color: var(--table-hover);
        }
        .qty-btn {
            background: var(--bg-hover);
            border: 1px solid var(--border);
            color: var(--text-main);
            width: 28px;
            height: 28px;
            border-radius: 4px;
            font-weight: bold;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }
        .qty-btn:hover {
            background: var(--primary);
            color: #fff;
        }
        .summary-box {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 1.25rem;
            color: var(--text-main);
        }
        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 0.45rem 0;
            font-size: 0.92rem;
            border-bottom: 1px dashed var(--border);
            color: var(--text-main);
        }
        .summary-row.total {
            border-top: 2px solid var(--primary);
            border-bottom: none;
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--primary);
            padding-top: 0.75rem;
            margin-top: 0.5rem;
        }

        /* الطباعة الحرارية والمستندات */
        @media print {
            body * {
                visibility: hidden;
            }
            #printableArea, #printableArea * {
                visibility: visible;
            }
            #printableArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 15px;
                background: #fff !important;
                color: #000 !important;
            }
            .no-print {
                display: none !important;
            }
        }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.65);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-content {
            background: var(--bg-card, #ffffff);
            border-radius: 8px;
            max-width: 680px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 1.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            border: 1px solid var(--border);
        }
        #printPreviewContainer {
            background: #ffffff !important;
            color: #000000 !important;
            padding: 5px;
            border-radius: 4px;
        }
        .thermal-receipt {
            max-width: 320px;
            margin: 0 auto;
            background: #ffffff !important;
            color: #000000 !important;
            padding: 15px;
            font-family: 'Courier New', Courier, monospace, 'Times New Roman';
            font-size: 12px;
            border: 1px solid #cbd5e1 !important;
        }
    </style>

</head>
<body>
    <nav class="navbar"></nav>

    <div class="container" style="margin-top: 1.5rem; margin-bottom: 2rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 0.5rem;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.65rem;">
                    <span class="hospital-icon-badge icon-blue" style="width: 36px; height: 36px; border-radius: 10px;">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <line x1="6" y1="8" x2="6.01" y2="8"/>
                            <line x1="10" y1="8" x2="10.01" y2="8"/>
                            <line x1="14" y1="8" x2="14.01" y2="8"/>
                            <line x1="18" y1="8" x2="18.01" y2="8"/>
                            <line x1="6" y1="12" x2="18" y2="12"/>
