        <div class="pos-grid">
            <!-- العمود الأيمن: بيانات الفاتورة وإضافة الأصناف -->
            <div>
                <!-- بيانات رأس الفاتورة -->
                <div class="card" style="margin-bottom: 1rem; padding: 1.1rem;">
                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 0.75rem;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="font-size: 0.82rem; font-weight: 700;">رقم الفاتورة</label>
                            <input type="text" id="invNumber" class="form-control" readonly style="font-weight: 800; background: var(--bg-hover); color: var(--primary); border: 1px solid var(--border);">
