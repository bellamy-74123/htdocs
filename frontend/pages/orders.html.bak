<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سجل الفواتير والطلبيات | نظام إدارة الصيدلية</title>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="../assets/css/chatbot-widget.css">
    <style>
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(0, 0, 0, 0.65);
            z-index: 99999;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .modal-content {
            background: var(--bg-card, #ffffff);
            border-radius: 8px;
            max-width: 680px;
            width: 100%;
            max-height: 90vh;
            overflow-y: auto;
            padding: 1.5rem;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            border: 1px solid var(--border);
        }
        #invoiceDetailContainer {
            background: #ffffff !important;
            color: #000000 !important;
            border-radius: 4px;
            padding: 5px;
        }
        @media print {
            body * {
                visibility: hidden;
            }
            #printableArea, #printableArea * {
                visibility: visible;
            }
            #printableArea {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 15px;
                background: #fff !important;
                color: #000 !important;
            }
        }
    </style>
</head>
<body>
    <nav class="navbar"></nav>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <div>
                    <h2 style="font-size: 1.25rem;">سجل فواتير الصرف والمبيعات والطلبيات</h2>
                    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.2rem;">متابعة فواتير الصرف وشحنات التوريد وحالة السداد مع إمكانية المعاينة وإعادة الطباعة.</p>
                </div>
                <div>
                    <a href="order_create.html" class="btn" style="font-size: 0.88rem;">إصدار فاتورة / طلبية جديدة (POS)</a>
                </div>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>رقم الفاتورة</th>
                        <th>نوع العملية</th>
                        <th>العميل / الجهة</th>
                        <th>طريقة الدفع</th>
                        <th>عدد الأصناف</th>
                        <th>الإجمالي (ريال)</th>
                        <th>التاريخ</th>
                        <th>العمليات</th>
                    </tr>
                </thead>
                <tbody id="ordersTableBody">
                    <tr><td colspan="8" style="text-align: center;">جاري استرجاع سجل الفواتير...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- نافذة معاينة وطباعة الفاتورة -->
    <div id="viewInvoiceModal" class="modal-overlay">
        <div class="modal-content invoice-modal-dialog">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem;">
                <h3 style="font-size: 1.1rem; margin: 0; font-weight: 800; color: #0f2942;">معاينة وتفاصيل الفاتورة</h3>
                <button onclick="closeInvoiceModal()" class="btn btn-secondary" style="padding: 0.2rem 0.6rem; font-size: 0.85rem;">إغلاق</button>
            </div>

            <div id="invoiceDetailContainer"></div>

            <div style="display: flex; justify-content: flex-end; gap: 0.5rem; margin-top: 1.25rem; border-top: 1px solid #e2e8f0; padding-top: 0.75rem;">
                <button onclick="closeInvoiceModal()" class="btn btn-secondary">إغلاق</button>
                <button onclick="printCurrentInvoice()" class="btn" style="font-weight: 700;">طباعة الفاتورة</button>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="../assets/js/supabase-client.js"></script>
    <script src="../assets/js/api.js"></script>
    <script src="../assets/js/app.js"></script>
    <script>
        let cachedOrders = [];

        // استعراض سجل الفواتير مباشرة بدون قيود أو شروط مصادقة
        loadOrders();

        async function loadOrders() {
            try {
                const res = await APIClient.request('orders.php');
                const tbody = document.getElementById('ordersTableBody');
                cachedOrders = (res.success && res.data && res.data.length > 0) ? res.data : DEMO_ORDERS;

                tbody.innerHTML = cachedOrders.map((o, idx) => {
                    let typeBadge = '<span class="badge badge-primary">توريد مشتريات</span>';
                    if (o.order_type === 'patient_sale' || o.order_type === 'dispense') {
                        typeBadge = '<span class="badge badge-success">مبيعات مرضى</span>';
                    } else if (o.order_type === 'department_dispense' || o.order_type === 'emergency') {
                        typeBadge = '<span class="badge badge-warning">صرف أقسام المستشفى</span>';
                    } else if (o.order_type === 'emergency_order') {
                        typeBadge = '<span class="badge badge-danger">شحنة طارئة</span>';
                    }

                    let payLabel = 'نقدي';
                    if (o.payment_method === 'card') payLabel = 'شبكة / بطاقة';
                    else if (o.payment_method === 'credit') payLabel = 'آجل / عهدة';

                    const itemsCount = (o.items && Array.isArray(o.items)) ? o.items.length : 1;
                    const invNumber = o.invoice_number || `#INV-${o.id}`;
                    const custName = o.customer_name || 'عميل نقدي';
                    const dateStr = o.created_at ? String(o.created_at).substring(0, 16) : '2026-08-24 10:00';

                    return `
                        <tr>
                            <td><strong style="color: var(--primary);">${invNumber}</strong></td>
                            <td>${typeBadge}</td>
                            <td>${custName}</td>
                            <td><span style="font-size: 0.85rem;">${payLabel}</span></td>
                            <td style="text-align: center;">${itemsCount}</td>
                            <td style="font-weight: 700;">${parseFloat(o.total_amount || 0).toFixed(2)}</td>
                            <td><span style="font-size: 0.82rem; color: var(--text-muted);">${dateStr}</span></td>
                            <td>
                                <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.65rem; font-size: 0.8rem;" onclick="viewInvoiceDetail(${idx})">معاينة / طباعة</button>
                            </td>
                        </tr>
                    `;
                }).join('');
            } catch (e) {
                console.error(e);
            }
        }

        function viewInvoiceDetail(index) {
            const o = cachedOrders[index];
            if (!o) return;

            const modal = document.getElementById('viewInvoiceModal');
            const container = document.getElementById('invoiceDetailContainer');

            let payLabel = 'نقدي (Cash)';
            if (o.payment_method === 'card') payLabel = 'شبكة / بطاقة بنكية (Card)';
            else if (o.payment_method === 'credit') payLabel = 'آجل / عهدة قسم (Credit)';

            let typeLabel = 'مبيعات وصرف نقدي للمرضى';
            if (o.order_type === 'department_dispense') typeLabel = 'صرف دوائي لأقسام المستشفى';
            else if (o.order_type === 'routine_restock') typeLabel = 'توريد مشتريات من مورد';

            const items = o.items || [];
            const subtotal = (o.subtotal || o.total_amount || 0).toFixed(2);
            const discount = (o.discount || 0).toFixed(2);
            const tax = (o.tax_amount || 0).toFixed(2);
            const grandTotal = parseFloat(o.total_amount || 0).toFixed(2);

            container.innerHTML = `
                <div class="invoice-paper invoice-wrapper" style="background: #ffffff !important; color: #000000 !important; padding: 20px; border: 1px solid #cbd5e1; border-radius: 4px; font-family: 'Times New Roman', serif;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #0f2942; padding-bottom: 10px; margin-bottom: 12px; background: #ffffff;">
                        <div>
                            <h2 style="font-size: 16px; margin: 0; color: #0f2942; font-weight: bold;">صيدلية المستشفى المركزي</h2>
                            <div style="font-size: 12px; color: #334155;">الرقم الضريبي: 300982341100003</div>
                        </div>
                        <div style="text-align: left;">
                            <div style="font-size: 14px; font-weight: bold; color: #0f2942;">فاتورة ${typeLabel}</div>
                            <div style="font-size: 12px; color: #000000;">رقم: <strong>${o.invoice_number || '#' + o.id}</strong></div>
                            <div style="font-size: 11px; color: #334155;">التاريخ: ${o.created_at || '2026-08-24'}</div>
                        </div>
                    </div>

                    <div class="invoice-header-box" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: #f8fafc !important; color: #000000 !important; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px; font-size: 12px; border: 1px solid #e2e8f0;">
                        <div><strong>المستلم / العميل:</strong> ${o.customer_name || 'عميل نقدي'}</div>
                        <div><strong>طريقة السداد:</strong> ${payLabel}</div>
                        <div><strong>حالة الفاتورة:</strong> مكتمل ومسدد</div>
                        <div><strong>الرقم المرجعي:</strong> #${o.id}</div>
                    </div>

                    ${o.notes ? `
                    <div class="invoice-header-box" style="background: #f8fafc !important; color: #000000 !important; padding: 8px 12px; border-radius: 4px; margin-bottom: 12px; font-size: 12px; border: 1px solid #e2e8f0;">
                        <strong>توجيهات الاستخدام وجرعة الدواء:</strong> ${o.notes}
                    </div>` : ''}

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 12px; font-size: 12px; background: #ffffff !important;">
                        <thead>
                            <tr style="background: #0f2942 !important; color: #ffffff !important;">
                                <th style="border: 1px solid #0f2942; padding: 5px; text-align: right; color: #ffffff !important; background: #0f2942 !important;">#</th>
                                <th style="border: 1px solid #0f2942; padding: 5px; text-align: right; color: #ffffff !important; background: #0f2942 !important;">الصنف الدوائي</th>
                                <th style="border: 1px solid #0f2942; padding: 5px; text-align: center; color: #ffffff !important; background: #0f2942 !important;">سعر الوحدة</th>
                                <th style="border: 1px solid #0f2942; padding: 5px; text-align: center; color: #ffffff !important; background: #0f2942 !important;">الكمية</th>
                                <th style="border: 1px solid #0f2942; padding: 5px; text-align: left; color: #ffffff !important; background: #0f2942 !important;">الإجمالي</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${items.map((it, i) => `
                                <tr style="border-bottom: 1px solid #e2e8f0; background: ${i % 2 === 0 ? '#ffffff' : '#f8fafc'} !important; color: #000000 !important;">
                                    <td style="border: 1px solid #cbd5e1; padding: 5px; color: #000000 !important;">${i + 1}</td>
                                    <td style="border: 1px solid #cbd5e1; padding: 5px; font-weight: bold; color: #000000 !important;">${it.name || it.medicine_name || 'دواء #' + it.medicine_id}</td>
                                    <td style="border: 1px solid #cbd5e1; padding: 5px; text-align: center; color: #000000 !important;">${parseFloat(it.unit_price || 0).toFixed(2)}</td>
                                    <td style="border: 1px solid #cbd5e1; padding: 5px; text-align: center; font-weight: bold; color: #000000 !important;">${it.quantity}</td>
                                    <td style="border: 1px solid #cbd5e1; padding: 5px; text-align: left; font-weight: bold; color: #000000 !important;">${parseFloat(it.total_price || (it.unit_price * it.quantity) || 0).toFixed(2)}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>

                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-top: 10px; background: #ffffff;">
                        <div style="font-size: 11px; color: #475569; max-width: 50%;">
                            * فاتورة صادرة ومعتمدة إلكترونياً.
                        </div>
                        <div style="width: 220px; font-size: 12px; line-height: 1.6; color: #000000;">
                            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 2px 0;"><span>المجموع الفرعي:</span><span>${subtotal} ريال</span></div>
                            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 2px 0;"><span>الخصم:</span><span>${discount} ريال</span></div>
                            <div style="display: flex; justify-content: space-between; border-bottom: 1px solid #e2e8f0; padding: 2px 0;"><span>الضريبة:</span><span>${tax} ريال</span></div>
                            <div style="display: flex; justify-content: space-between; font-weight: bold; font-size: 13px; color: #0f2942; padding-top: 4px;"><span>الإجمالي النهائي:</span><span>${grandTotal} ريال</span></div>
                        </div>
                    </div>
                </div>
            `;

            modal.style.display = 'flex';
        }

        function closeInvoiceModal() {
            document.getElementById('viewInvoiceModal').style.display = 'none';
        }

        function printCurrentInvoice() {
            const previewContent = document.getElementById('invoiceDetailContainer').innerHTML;
            const printArea = document.getElementById('printableArea');
            printArea.innerHTML = previewContent;
            printArea.style.display = 'block';

            window.print();

            setTimeout(() => {
                printArea.style.display = 'none';
                printArea.innerHTML = '';
            }, 1000);
        }
    </script>
</body>
</html>
