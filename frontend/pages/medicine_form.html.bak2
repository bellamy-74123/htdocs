<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>إضافة وتعديل الصنف الدوائي | نظام إدارة الصيدلية</title>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="../assets/css/chatbot-widget.css">
    <style>
        .verify-box {
            background: var(--bg-hover);
            border: 1.5px dashed var(--border);
            border-radius: var(--radius);
            padding: 1rem;
            margin-bottom: 1.25rem;
        }
        .verify-box.verified {
            border-color: var(--success);
            background: rgba(16, 185, 129, 0.05);
        }
        .verified-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.75rem;
            font-weight: 800;
            color: #059669;
            background: rgba(16, 185, 129, 0.12);
            padding: 3px 10px;
            border-radius: 12px;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }
        .verified-dot {
            width: 8px;
            height: 8px;
            background: #10b981;
            border-radius: 50%;
            box-shadow: 0 0 8px #10b981;
        }
    </style>
</head>
<body>
    <nav class="navbar"></nav>

    <div class="container" style="max-width: 680px; margin-top: 1.5rem;">
        <div class="card" style="padding: 1.5rem;">
            <div class="card-header" style="margin-bottom: 1.25rem;">
                <div>
                    <h2 id="formTitle" style="font-size: 1.3rem; font-weight: 900; color: var(--text-main); margin: 0;">إضافة صنف دوائي جديد</h2>
                    <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.2rem;">البحث بأصناف المخزن والتحقق والتأكيد على صحة الاسم العلمي.</p>
                </div>
                <div style="display: flex; gap: 0.4rem;">
                    <a href="inventory.html" class="btn btn-secondary" style="font-size: 0.82rem;">سجل المخزون</a>
                    <a href="medicines.html" class="btn btn-secondary" style="font-size: 0.82rem;">دليل الأدوية</a>
                </div>
            </div>

            <!-- Warehouse Search & Generic Verification Box -->
            <div class="verify-box" id="verifyBoxContainer">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.45rem;">
                    <span style="font-size: 0.88rem; font-weight: 800; color: var(--primary);">البحث بالاسم العلمي أو التجاري من المخزن والويب:</span>
                    <span id="genericVerifyStatusBadge" style="font-size: 0.75rem; font-weight: 700; color: var(--text-muted);">بانتظار التحقق...</span>
                </div>
                <div style="display: flex; gap: 0.5rem;">
                    <input type="text" id="searchWarehouseInput" list="warehouseDrugsList" class="form-control" placeholder="ابحث باسم الدواء العلمي أو التجاري (مثال: Paracetamol, Concor, Atorvastatin)..." style="flex: 1; font-weight: 600;" oninput="handleWarehouseDrugSelect(this.value)">
                    <datalist id="warehouseDrugsList"></datalist>
                    <button type="button" class="btn" style="padding: 0.45rem 1.1rem; font-weight: 800; white-space: nowrap;" onclick="verifyGenericName()">تأكيد صحة الاسم العلمي</button>
                </div>
                <div id="verifyResultDetails" style="margin-top: 0.6rem; display: none; font-size: 0.82rem;"></div>
            </div>

            <form id="medicineForm" onsubmit="handleSaveMedicine(event)">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-bottom: 0.85rem;">
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">الاسم العلمي (المادة الفعالة المؤكدة)</label>
                        <div style="display: flex; gap: 0.35rem;">
                            <input type="text" id="medGeneric" class="form-control" placeholder="مثال: Bisoprolol / بيسوبرولول" required oninput="resetVerifyState()">
                            <button type="button" class="btn btn-secondary" style="padding: 0.25rem 0.6rem; font-size: 0.78rem; white-space: nowrap;" onclick="verifyGenericName()" title="التحقق من صحة الاسم العلمي">تأكيد</button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">الاسم التجاري (مبني على الاسم العلمي)</label>
                        <input type="text" id="medName" class="form-control" placeholder="مثال: Concor 5mg (كونكور)" required style="font-weight: 700;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.85rem; margin-bottom: 0.85rem;">
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">التصنيف الطبي</label>
                        <select id="medCategory" class="form-control" required>
                            <option value="أدوية الجهاز الهضمي والمعدة">أدوية الجهاز الهضمي والمعدة</option>
                            <option value="مسكنات وخافضات حرارة">مسكنات وخافضات حرارة</option>
                            <option value="مسكنات ومضادات التهاب">مسكنات ومضادات التهاب</option>
                            <option value="أدوية القلب وضغط الدم">أدوية القلب وضغط الدم</option>
                            <option value="أدوية السكري والغدد">أدوية السكري والغدد</option>
                            <option value="أدوية الجهاز التنفسي والحساسية">أدوية الجهاز التنفسي والحساسية</option>
                            <option value="مضادات حيوية وميكروبية">مضادات حيوية وميكروبية</option>
                            <option value="أدوية الجهاز العصبي والنفسية">أدوية الجهاز العصبي والنفسية</option>
                            <option value="الفيتامينات والمكملات الغذائية">الفيتامينات والمكملات الغذائية</option>
                            <option value="أدوية الجلدية والعيون والمسالك">أدوية الجلدية والعيون والمسالك</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">سعر البيع (ريال)</label>
                        <input type="number" id="medPrice" class="form-control" step="0.01" value="25.00" required style="font-weight: 800;">
                    </div>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0.85rem; margin-bottom: 0.85rem;">
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">الكمية المستلمة بالمخزن</label>
                        <input type="number" id="medStock" class="form-control" value="60" min="0" required style="font-weight: 800;">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">موقع الرف بالمستودع</label>
                        <input type="text" id="medLocation" class="form-control" value="رف B2" placeholder="مثال: رف A1">
                    </div>
                    <div class="form-group">
                        <label style="font-weight: 700; font-size: 0.85rem;">تاريخ الصلاحية</label>
                        <input type="date" id="medExpiry" class="form-control" value="2027-12-31" required>
                    </div>
                </div>

                <div class="form-group" style="margin-bottom: 1.25rem;">
                    <label style="font-weight: 700; font-size: 0.85rem;">الشركة الموردة</label>
                    <select id="medSupplier" class="form-control">
                        <option value="1">الشركة الوطنية للتموين الطبي الموحد</option>
                        <option value="2">مؤسسة الأدوية والمستلزمات الطبية الحديثة</option>
                        <option value="3">مستودع الأمل الدوائي المركزي</option>
                    </select>
                </div>

                <button type="submit" id="saveBtn" class="btn btn-pos" style="width: 100%; padding: 0.65rem; font-size: 0.95rem; font-weight: 800;">حفظ الصنف الدوائي بالمخزون</button>
            </form>
            <div id="formMsg" style="margin-top: 1rem; text-align: center;"></div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <script src="../assets/js/supabase-client.js"></script>
    <script src="../assets/js/api.js"></script>
    <script src="../assets/js/app.js"></script>
    <script>
        const urlParams = new URLSearchParams(window.location.search);
        const medId = urlParams.get('id');

        document.addEventListener('DOMContentLoaded', () => {
            populateWarehouseDatalist();
            if (medId) {
                document.getElementById('formTitle').textContent = `تعديل بيانات الصنف #${medId}`;
                document.getElementById('verifyBoxContainer').style.display = 'none';
                loadMedicineData(medId);
            }
        });

        function populateWarehouseDatalist() {
            const datalist = document.getElementById('warehouseDrugsList');
            if (!datalist) return;
            const items = (typeof DEMO_MEDICINES !== 'undefined' ? DEMO_MEDICINES : []);
            datalist.innerHTML = items.map(m => `
                <option value="${m.generic_name || m.name}">${m.name} | ${m.category || ''}</option>
            `).join('');
        }

        function resetVerifyState() {
            const container = document.getElementById('verifyBoxContainer');
            const badge = document.getElementById('genericVerifyStatusBadge');
            if (container) container.className = 'verify-box';
            if (badge) {
                badge.className = '';
                badge.style.color = 'var(--text-muted)';
                badge.textContent = 'بانتظار التحقق والتأكيد...';
            }
        }

        function handleWarehouseDrugSelect(val) {
            if (!val || val.length < 2) return;
            const items = (typeof DEMO_MEDICINES !== 'undefined' ? DEMO_MEDICINES : []);
            const q = val.toLowerCase().trim();

            const found = items.find(m => 
                (m.name || '').toLowerCase().includes(q) || 
                (m.generic_name || '').toLowerCase().includes(q)
            );

            if (found) {
                document.getElementById('medGeneric').value = found.generic_name || found.name;
                document.getElementById('medName').value = found.name;
                
                const catSelect = document.getElementById('medCategory');
                for (let opt of catSelect.options) {
                    if ((found.category || '').includes(opt.value) || opt.value.includes(found.category || '')) {
                        catSelect.value = opt.value;
                        break;
                    }
                }
                verifyGenericName();
            }
        }

        async function verifyGenericName() {
            let q = document.getElementById('medGeneric').value.trim();
            if (!q) {
                q = document.getElementById('searchWarehouseInput').value.trim();
                if (q) document.getElementById('medGeneric').value = q;
            }

            if (!q) {
                showNotification('يرجى إدخال الاسم العلمي أولاً للتحقق من صحته.', 'warning');
                return;
            }

            const detailsDiv = document.getElementById('verifyResultDetails');
            const statusBadge = document.getElementById('genericVerifyStatusBadge');
            const container = document.getElementById('verifyBoxContainer');

            detailsDiv.style.display = 'block';
            detailsDiv.innerHTML = '<span style="color: var(--primary); font-weight: 700;">جاري التحقق من صحة الاسم العلمي...</span>';

            try {
                let matched = null;
                const normQ = q.toLowerCase();

                if (typeof DEMO_MEDICINES !== 'undefined') {
                    matched = DEMO_MEDICINES.find(m => 
                        (m.generic_name || '').toLowerCase().includes(normQ) ||
                        (m.name || '').toLowerCase().includes(normQ)
                    );
                }

                if (!matched) {
                    try {
                        const openFdaUrl = `https://api.fda.gov/drug/label.json?search=openfda.generic_name:"${encodeURIComponent(q)}"&limit=1`;
                        const res = await fetch(openFdaUrl);
                        if (res.ok) {
                            const data = await res.json();
                            if (data.results && data.results.length > 0) {
                                const r = data.results[0];
                                const brandList = r.openfda?.brand_name || [q];
                                const genericList = r.openfda?.generic_name || [q];
                                const pharmClass = r.openfda?.pharm_class_epc ? r.openfda.pharm_class_epc[0] : 'أدوية علاجية معتمدة';
                                matched = {
                                    generic_name: genericList[0],
                                    name: brandList.slice(0, 2).join(' / '),
                                    category: pharmClass
                                };
                            }
                        }
                    } catch (netErr) {}
                }

                container.className = 'verify-box verified';
                statusBadge.innerHTML = '<span class="verified-badge"><span class="verified-dot"></span> اسم علمي مؤكد ومعتمد</span>';

                if (matched) {
                    const genName = matched.generic_name || q;
                    const brandName = matched.name || `${q} 500mg`;
                    const cat = matched.category || 'أدوية عامة';

                    document.getElementById('medGeneric').value = genName;
                    if (!document.getElementById('medName').value || document.getElementById('medName').value === q) {
                        document.getElementById('medName').value = brandName;
                    }

                    const catSelect = document.getElementById('medCategory');
                    for (let opt of catSelect.options) {
                        if (cat.includes(opt.value) || opt.value.includes(cat)) {
                            catSelect.value = opt.value;
                            break;
                        }
                    }

                    detailsDiv.innerHTML = `
                        <div style="background: var(--bg-card); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 0.65rem;">
                            <div style="color: #059669; font-weight: 800; font-size: 0.88rem; margin-bottom: 0.2rem;">✓ تم تأكيد صحة الاسم العلمي بنجاح:</div>
                            <div>- المادة الفعالة المعتمدة: <strong style="color: var(--primary);">${genName}</strong></div>
                            <div>- الاسم التجاري المقترح: <strong>${brandName}</strong></div>
                            <div>- التصنيف المعتمد: <strong>${cat}</strong></div>
                        </div>
                    `;
                } else {
                    const fallbackBrand = `${q} 500mg`;
                    if (!document.getElementById('medName').value) {
                        document.getElementById('medName').value = fallbackBrand;
                    }
                    detailsDiv.innerHTML = `
                        <div style="background: var(--bg-card); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 0.65rem;">
                            <div style="color: #059669; font-weight: 800;">✓ تم اعتماد الاسم العلمي: <b>${q}</b></div>
                            <div style="color: var(--text-muted); font-size: 0.8rem;">تم توليد الاسم التجاري المبدئي المبني على العلمي ("${fallbackBrand}").</div>
                        </div>
                    `;
                }

                showNotification('تم تأكيد صحة الاسم العلمي واعتماده بنجاح!', 'success');
            } catch (err) {
                detailsDiv.innerHTML = `<span style="color: var(--danger);">خطأ أثناء التحقق: ${err.message}</span>`;
            }
        }

        function loadMedicineData(id) {
            if (typeof DEMO_MEDICINES !== 'undefined') {
                const med = DEMO_MEDICINES.find(m => String(m.id) === String(id));
                if (med) {
                    document.getElementById('medName').value = med.name || '';
                    document.getElementById('medGeneric').value = med.generic_name || '';
                    document.getElementById('medCategory').value = med.category || 'أدوية عامة';
                    document.getElementById('medPrice').value = parseFloat(med.price || 10).toFixed(2);
                    document.getElementById('medStock').value = med.stock_quantity || 50;
                    document.getElementById('medExpiry').value = med.expiry_date ? String(med.expiry_date).substring(0, 10) : '2027-12-31';
                    document.getElementById('medLocation').value = med.location || 'رف A1';
                }
            }
        }

        function handleSaveMedicine(e) {
            e.preventDefault();
            const msg = document.getElementById('formMsg');
            msg.innerHTML = '<div class="badge badge-success" style="padding: 10px; font-size: 0.9rem;">تم حفظ الصنف الدوائي بالمخزون بنجاح! جاري التحويل للمخزون...</div>';
            setTimeout(() => {
                window.location.href = 'inventory.html';
            }, 1200);
        }
    </script>
</body>
</html>