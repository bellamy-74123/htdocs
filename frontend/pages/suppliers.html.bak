<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>دليل الموردين | نظام إدارة الصيدلية</title>
    <script>
        (function() {
            const theme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
    <link rel="stylesheet" href="../assets/css/style.css">
    <link rel="stylesheet" href="../assets/css/chatbot-widget.css">
</head>
<body>
    <nav class="navbar"></nav>

    <div class="container">
        <div class="card">
            <div class="card-header">
                <div>
                    <h2 style="font-size: 1.25rem;">دليل الشركات الموردة</h2>
                    <p style="color: var(--text-muted); font-size: 0.88rem; margin-top: 0.2rem;">بيانات شركات التوزيع وموزعي الأدوية المعتمدين.</p>
                </div>
                <div id="addSupBtnContainer">
                    <a href="supplier_form.html" class="btn" style="font-size: 0.88rem;">إضافة مورد جديد</a>
                </div>
            </div>

            <table>
                <thead>
                    <tr>
                        <th>الرمز</th>
                        <th>اسم الشركة الموردة</th>
                        <th>مسؤول الاتصال</th>
                        <th>رقم الهاتف</th>
                        <th>البريد الإلكتروني</th>
                        <th>المقر</th>
                    </tr>
                </thead>
                <tbody id="suppliersTableBody">
                    <tr><td colspan="6" style="text-align: center;">جاري استرجاع بيانات الموردين...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <script src="../assets/js/api.js"></script>
    <script src="../assets/js/app.js"></script>
    <script>
        if (AppAuth.requireAuth(['admin', 'supervisor'])) {
            loadSuppliers();
        }

        async function loadSuppliers() {
            try {
                const res = await APIClient.request('suppliers.php');
                const tbody = document.getElementById('suppliersTableBody');
                if (res.success && res.data && res.data.length > 0) {
                    tbody.innerHTML = res.data.map(s => `
                        <tr>
                            <td>#${s.id}</td>
                            <td><strong>${s.name}</strong></td>
                            <td>${s.contact_person || '-'}</td>
                            <td>${s.phone || '-'}</td>
                            <td>${s.email || '-'}</td>
                            <td>${s.address || '-'}</td>
                        </tr>
                    `).join('');
                } else {
                    const mockSuppliers = [
                        { id: 1, name: "الشركة الوطنية للتموين الطبي", contact_person: "أ. خالد النجار", phone: "01-445566", email: "supply@national-med.com", address: "صنعاء - شارع الزبيري" },
                        { id: 2, name: "مؤسسة الأدوية والمستلزمات الحديثة", contact_person: "د. سامي الحداد", phone: "01-223344", email: "info@modern-pharma.com", address: "صنعاء - شارع حدة" },
                        { id: 3, name: "مستودع الأمل للأدوية والمضادات", contact_person: "أ. طارق العريقي", phone: "01-778899", email: "sales@alamal-pharma.com", address: "صنعاء - الحصبة" }
                    ];
                    tbody.innerHTML = mockSuppliers.map(s => `
                        <tr>
                            <td>#${s.id}</td>
                            <td><strong>${s.name}</strong></td>
                            <td>${s.contact_person}</td>
                            <td>${s.phone}</td>
                            <td>${s.email}</td>
                            <td>${s.address}</td>
                        </tr>
                    `).join('');
                }
            } catch (e) {
                console.error(e);
            }
        }
    </script>
</body>
</html>
