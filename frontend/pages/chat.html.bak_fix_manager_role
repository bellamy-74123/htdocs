            }

            function formatMarkdownReply(text) {
                if (!text) return '';
                let formatted = stripClientEmojis(text)
                    .replace(/### (.*)/g, '<h3 style="color: var(--primary); margin-bottom: 0.5rem; font-size: 0.92rem; font-weight: 800;">$1</h3>')
                    .replace(/#### (.*)/g, '<h4 style="color: var(--text-main); margin: 0.75rem 0 0.4rem 0; font-size: 0.85rem; font-weight: 700; border-bottom: 1px solid var(--border); padding-bottom: 3px;">$1</h4>')
                    .replace(/\*\*(.*?)\*\*/g, '<strong style="color: var(--text-main); font-weight: 700;">$1</strong>')
                    .replace(/`([^`]+)`/g, '<code style="background: var(--bg-main); color: var(--accent); border: 1px solid var(--border); padding: 2px 6px; border-radius: 6px; font-size: 0.85em; font-family: monospace;">$1</code>')
