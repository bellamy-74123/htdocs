    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const chatMessages = document.getElementById('chatMessages');
            const chatForm = document.getElementById('chatForm');
            const chatInput = document.getElementById('chatInput');
            const typingIndicator = document.getElementById('typingIndicator');
            const btnClear = document.getElementById('btnClearChat');

            let chatHistory = [];
            let liveMedicines = [];

            // جلب أحدث بيانات الأدوية من قاعدة البيانات
            async function refreshDatabase() {
                try {
                    const res = await APIClient.request('medicines.php');
                    if (res && res.success && res.data && res.data.length > 0) {
                        liveMedicines = res.data;
                        return liveMedicines;
                    }
                } catch (e) {
                    console.warn('Could not fetch remote medicines, falling back to local dataset...');
                }
                if (typeof DEMO_MEDICINES !== 'undefined') {
                    liveMedicines = DEMO_MEDICINES;
                }
                return liveMedicines;
            }

            await refreshDatabase();

            window.askQuickPrompt = function(promptText) {
                if (chatInput) {
                    chatInput.value = promptText;
                    chatForm.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true }));
                }
            };

            
            chatForm.addEventListener('submit', async (e) => {
                e.preventDefault();
                const text = chatInput.value.trim();
                if (!text) return;

                appendMessage('user', text);
                chatInput.value = '';
                chatHistory.push({ role: 'user', content: text });

                typingIndicator.style.display = 'flex';
                chatMessages.scrollTop = chatMessages.scrollHeight;

                try {
                    const currentMeds = await refreshDatabase();
                    let responseData = null;

                    // 1. الاتصال بخادم محرك الذكاء الاصطناعي (FastAPI / NLP)
                    if (!responseData) {
                        try {
                            const pyRes = await fetch('http://127.0.0.1:8000/api/chat', {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ message: text, medicines: currentMeds, history: chatHistory })
                            });
                            if (pyRes.ok) {
                                const pyJson = await pyRes.json();
                                if (pyJson.success && pyJson.data) {
                                    responseData = pyJson.data;
                                }
                            }
                        } catch (err) {
                            console.warn('FastAPI direct connection failed, trying PHP backend proxy...');
                        }
                    }

                    // 3. الأولوية الثالثة: وسيط PHP المرتبط بـ MySQL
                    if (!responseData) {
                        const candidatePhp = [
                            'http://localhost:8080/api/chatbot.php',
                            '../../backend/api/chatbot.php',
                            '../backend/api/chatbot.php'
                        ];
                        for (const phpUrl of candidatePhp) {
                            try {
                                const phpRes = await fetch(phpUrl, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ message: text, medicines: currentMeds, history: chatHistory })
                                });
                                if (phpRes.ok) {
                                    const resJson = await phpRes.json();
                                    if (resJson.success && resJson.data) {
                                        responseData = resJson.data;
                                        break;
                                    }
                                }
                            } catch (err2) {}
                        }
                    }

                    // 4. الأولوية الرابعة: محرك الاستعلام السريري المحلي المتكامل في المتصفح
                    if (!responseData) {
                        responseData = queryLiveDatabase(text, currentMeds);
                    }

                    typingIndicator.style.display = 'none';

                    if (responseData && responseData.reply) {
                        appendMessage('bot', formatMarkdownReply(responseData.reply));
                        chatHistory.push({ role: 'assistant', content: responseData.reply });
                    } else {
                        appendMessage('bot', 'تمت معالجة استفسارك بنجاح.');
                    }
                } catch (error) {
                    typingIndicator.style.display = 'none';
                    appendMessage('bot', 'تعذر معالجة الطلب حالياً.');
                }

                chatMessages.scrollTop = chatMessages.scrollHeight;
            });

            btnClear.addEventListener('click', () => {
                chatHistory = [];
                chatMessages.innerHTML = `
                    <div class="msg bot">
                        <div class="msg-bubble">
                            <h3 style="margin-bottom: 0.5rem; color: var(--primary);">تم بدء جلسة استعلام جديدة</h3>
                            <p>تفضل بطرح سؤالك الدوائي أو أعراض المريض وسيقوم المساعد بالبحث والتحليل المباشر.</p>
                        </div>
                    </div>
                `;
            });

            function appendMessage(sender, htmlContent) {
                const msgDiv = document.createElement('div');
                msgDiv.className = `msg ${sender}`;
                msgDiv.innerHTML = `<div class="msg-bubble">${htmlContent}</div>`;
                chatMessages.appendChild(msgDiv);
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            // محرك تشخيص الأعراض والبحث الذكي المحلي في المتصفح (Client-side Clinical NLP Engine)
            
            function renderChatMedActionCard(m, isCheapest = false) {
                const posUrl = `order_create.html?med_id=${m.id}&auto_add=1`;
                const reqUrl = `orders.html?action=request&med=${encodeURIComponent(m.name)}`;
                const stock = m.stock_quantity !== undefined ? m.stock_quantity : 0;
                const cheapestBadge = isCheapest ? '<span class="badge badge-success" style="font-size:0.75rem; padding: 3px 8px; margin-inline-start: 6px;">الخيار الأوفر</span>' : '';

                return `
                    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: 8px; padding: 10px 14px; margin: 8px 0; box-shadow: var(--shadow-sm); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
                        <div style="flex: 1; min-width: 200px;">
                            <strong style="color: var(--primary); font-size: 0.88rem;">${m.name}</strong> ${cheapestBadge}
                            <div style="font-size: 0.76rem; color: var(--text-muted); margin-top: 3px;">
                                المادة الفعالة: <span class="generic-name" style="font-family: 'Times New Roman', Times, 'Simplified Arabic', serif; font-size: 0.86rem; color: var(--text-muted); font-style: italic;">${m.generic_name || '-'}</span> | السعر: <strong>${parseFloat(m.price || 0).toFixed(2)} ريال</strong> | الرصيد: <strong>${stock} علبة</strong>
                            </div>
                        </div>
                        <div style="display: flex; gap: 6px;">
                            <a href="${posUrl}" class="btn btn-pos" style="font-size: 0.76rem; font-weight: 800; padding: 4px 10px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                                + صرف في الفاتورة
                            </a>
                            <a href="${reqUrl}" class="btn btn-secondary" style="font-size: 0.74rem; font-weight: 700; padding: 4px 8px; border-radius: 8px; text-decoration: none;">
                                طلب توفير للمدير
                            </a>
                        </div>
                    </div>
                `;
            }

            function queryLiveDatabase(query, medicines) {
                const q = (query || '').toLowerCase().trim();
                const meds = (medicines && medicines.length > 0) ? medicines : (typeof DEMO_MEDICINES !== 'undefined' ? DEMO_MEDICINES : []);

                if (q.includes('مرحبا') || q.includes('اهلا') || q.includes('السلام') || q.includes('هلا') || q.includes('صباح') || q.includes('مساء')) {
                    return {
                        reply: "أهلاً بك. **المساعد الدوائي الذكي** متصل بقاعدة بيانات الصيدلية للإجابة عن أسعار الأدوية، توفر المخزون، والبدائل، واقتراح الأدوية المناسبة لحالات وأعراض المرضى (مثل: الصداع، الحمى، حموضة المعدة، الكحة، آلام المفاصل والأسنان)."
                    };
                }

                // 1. أنطولوجيا الأعراض السريرية الشاملة
                const SYMPTOM_RULES = [
                    {
                        id: "HEADACHE",
                        title: "الصداع والصداع النصفي (الشقيقة) وتسكين الآلام العامة",
                        keywords: ["صداع", "راس", "رأس", "شقيقة", "شقيقه", "مصدع", "يوجعني راسي", "الم بالراس", "وجع راس", "صداع شديد"],
                        generics: ["باراسيتامول", "إيبوبروفين", "ديكلوفيناك", "كافيين"],
                        categories: ["مسكن", "مسكنات", "خافض حرارة", "مسكن وخافض حرارة", "مسكن ومضاد للالتهاب"],
                        advice: "يُفضل أخذ قرص من الباراسيتامول أو البنادول إكسترا بعد الأكل مع شرب كمية وافرة من الماء. في حال الصداع الشديد أو النصفي، يمكن استخدام الإيبوبروفين (بروفين) أو الرابيدوس/كتافلام.",
                        precautions: "يُمنع استخدام الإيبوبروفين والديكلوفيناك لمرضى قرحة المعدة أو القصور الكلوي. استشر الطبيب إذا استمر الصداع لأكثر من 3 أيام."
                    },
                    {
                        id: "FEVER",
                        title: "الحمى وارتفاع درجة الحرارة وتكسير الجسم",
                        keywords: ["حرارة", "حراره", "سخونة", "سخونه", "حمى", "حمي", "مكسر", "ساخن", "مسخن", "قشعريرة", "تنزيل الحرارة", "حرارته مرتفعة", "حرارته مرتفعه"],
                        generics: ["باراسيتامول", "إيبوبروفين"],
                        categories: ["خافض حرارة", "مسكن وخافض حرارة", "مسكن"],
                        advice: "تناول الباراسيتامول (500-1000 مجم كل 6-8 ساعات عند اللزوم، بحد أقصى 4000 مجم يومياً) مع عمل كمادات ماء فاتر وتناول السوائل بكثرة.",
                        precautions: "إذا تجاوزت الحرارة 39°C أو استمرت لأكثر من 48 ساعة دون انخفاض، يجب مراجعة الطوارئ فوراً."
                    },
